---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Enquiry received | Pilot Systems" description="Thanks for your enquiry. Pilot Systems aims to reply within 24 hours to set up your free discovery call." noindex>
  <section class="section msg">
    <div class="container narrow">
      <span class="tick" aria-hidden="true">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
      </span>
      <h1 class="h2">Thanks, your enquiry is in</h1>
      <p class="lead">We aim to get back to you within 24 hours to set up a time to chat.</p>
      <p class="lead">In a hurry? Call <a href={site.phoneHref}><strong>{site.phoneDisplay}</strong></a>.</p>
      <a class="btn btn--primary" href="/">Back to home</a>
      <p class="kit">While you wait: <a href="/kit">get the free Tradie Follow-Up Kit</a>, with 10 messages you can copy today.</p>
    </div>
  </section>
</BaseLayout>

<script>
  import { track } from '@vercel/analytics';
  // Count an enquiry once (set by the contact form just before it came here).
  // Only yes/no for the newsletter box: nothing personal is sent.
  try {
    const optedIn = sessionStorage.getItem('pilot-enquiry-sent');
    if (optedIn) {
      sessionStorage.removeItem('pilot-enquiry-sent');
      track('Enquiry sent', { newsletter: optedIn });
    }
  } catch { /* storage blocked: skip the event */ }
</script>

<style>
  .msg { min-height: 60vh; display: flex; align-items: center; }
  .narrow { max-width: 760px; }
  .tick { width: 68px; height: 68px; border-radius: 50%; background: var(--amber); color: var(--ink-900); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 24px; animation: pop .5s cubic-bezier(.2, .9, .3, 1.4) both; }
  @keyframes pop { from { transform: scale(.4); opacity: 0; } to { transform: none; opacity: 1; } }
  .h2 { font-size: clamp(34px, 5vw, 56px); margin-bottom: 20px; }
  .lead { margin-bottom: 14px; }
  .btn { margin-top: 18px; }
  .kit { margin-top: 28px; color: var(--text-2); }
</style>
