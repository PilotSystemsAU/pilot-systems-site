---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { EMAIL_MARKETING_LIVE, kit } from '../../data/consent';
// Until email marketing goes live, send visitors to the home page.
if (!EMAIL_MARKETING_LIVE) return Astro.redirect('/');
---

<BaseLayout title="Your kit is ready | Pilot Systems" description="Download the free Tradie Follow-Up Kit from Pilot Systems." noindex>
  <section class="section msg">
    <div class="container narrow">
      <span class="tick" aria-hidden="true">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
      </span>
      <h1 class="h2">Your kit is ready</h1>
      <p class="lead">Download {kit.name} now. A copy is also on its way to your inbox. If you can't see it in a few minutes, check your junk folder.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={kit.pdf} download>Download the kit (PDF)</a>
        <a class="btn btn--outline" href="/">Back to home</a>
      </div>
      <div class="next card">
        <h2 class="h3">Rather have it all send itself?</h2>
        <p>We set up these follow-ups to run automatically in the software you already use. Book a free 15–25 minute discovery call, or call <a href={site.phoneHref}><strong>{site.phoneDisplay}</strong></a>.</p>
        <a class="text-link" href="/contact">{site.cta}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { track } from '@vercel/analytics';
  // Count a kit signup once (set by the /kit form just before it came here).
  try {
    if (sessionStorage.getItem('pilot-kit-signup')) {
      sessionStorage.removeItem('pilot-kit-signup');
      track('Kit signup', { source: 'kit page' });
    }
  } catch { /* storage blocked: skip the event */ }
</script>

<style>
  .msg { min-height: 60vh; display: flex; align-items: center; }
  .narrow { max-width: 760px; }
  .tick { width: 68px; height: 68px; border-radius: 50%; background: var(--amber); color: var(--ink-900); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 24px; }
  .h2 { font-size: clamp(34px, 5vw, 56px); margin-bottom: 20px; }
  .lead { margin-bottom: 24px; }
  .next { margin-top: 40px; }
  .h3 { font-size: 18px; font-weight: 800; text-transform: uppercase; letter-spacing: .02em; margin-bottom: 10px; }
  .next p { margin-bottom: 12px; color: var(--text-2); }
</style>
