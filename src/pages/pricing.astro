---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { websites, systemsPricing, care } from '../data/offers';
import { pricingFaqs } from '../data/faqs';
---

<BaseLayout
  title="Pricing | Pilot Systems: Websites & Automations for Tradies"
  description="Clear, fixed prices for tradie websites, missed-call text-back, software tune-ups and care. Founding rates for our first 5 clients. No GST added."
>
  <PageHero
    kicker="Pricing"
    title="Clear prices. Written scope. No lock-in."
    intro="You'll know exactly what you're getting and what it costs before we start."
  >
    <div class="founding">
      <span class="founding-tag">Founding rates</span>
      <p><strong>Founding rates for our first 5 clients.</strong> These prices are for our first 5 projects while we build our portfolio. Pilot Systems isn't registered for GST, so no GST is added.</p>
    </div>
  </PageHero>

  <!-- WEBSITES -->
  <section class="section" aria-labelledby="web-heading">
    <div class="container">
      <div data-reveal>
        <p class="kicker">Website packages</p>
        <h2 id="web-heading" class="h2">Websites</h2>
      </div>
      <ul class="tiers" role="list">
        {websites.map((w, i) => (
          <li id={w.id} class:list={['tier', { featured: w.featured }]} data-reveal style={`--reveal-delay:${i * 100}ms`}>
            {w.featured && <span class="badge">Recommended</span>}
            <h3 class="tier-name">{w.name}</h3>
            <p class="tier-label">{w.priceLabel}</p>
            <p class="tier-price">{w.price}</p>
            <dl>
              <div><dt>Best for</dt><dd>{w.pricingBestFor}</dd></div>
              <div><dt>Timeline</dt><dd>{w.pricingTimeline}</dd></div>
              <div><dt>Payments</dt><dd>{w.payments}</dd></div>
            </dl>
            <div class="tier-actions">
              <a class="btn btn--primary" href="/contact">Book a free call</a>
              <a class="text-link" href="/services#websites">What's included →</a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SYSTEMS + CARE -->
  <section id="systems" class="section section--white" aria-labelledby="sys-heading">
    <div class="container">
      <div data-reveal>
        <p class="kicker">Systems</p>
        <h2 id="sys-heading" class="h2">Systems</h2>
      </div>
      <div class="table-wrap" data-reveal>
        <table>
          <thead><tr><th scope="col">Service</th><th scope="col">Price</th><th scope="col">Payments</th></tr></thead>
          <tbody>
            {systemsPricing.map((s) => (
              <tr>
                <th scope="row"><a href={s.href}>{s.name}</a></th>
                <td class="p">{s.price}</td>
                <td>{s.payments}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div id="care" class="care-block" data-reveal>
        <p class="kicker">Care</p>
        <h2 class="h2">Care</h2>
        <ul class="care" role="list">
          {care.map((c) => (
            <li class="care-card">
              <a href={`/services#${c.id}`}>
                <span class="care-name">{c.name}</span>
                <span class="care-price">{c.price}<span>{c.per}</span></span>
                <span class="care-more">What's included →</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="note">Month to month. Cancel with 30 days' notice.</p>
      </div>
    </div>
  </section>

  <!-- THE FINE PRINT -->
  <section class="section" aria-label="What affects the price, costs paid by you, what's not included and ownership">
    <div class="container fine">
      <div class="card card--hover" data-reveal>
        <h2 class="h3">What affects the price</h2>
        <p class="muted">"From" prices go up when:</p>
        <ul class="plain">
          <li>you need more pages or features than the package includes;</li>
          <li>your setup is more complex (for example, several phone numbers or several team members getting alerts);</li>
          <li>something needs to be built rather than set up in software you already have.</li>
        </ul>
        <p class="strong">You'll always get a fixed price in writing before you commit.</p>
      </div>
      <div class="card card--hover" data-reveal style="--reveal-delay:90ms">
        <h2 class="h3">Costs paid directly by you</h2>
        <p class="muted">These stay in your name, so you're never locked in:</p>
        <ul class="plain">
          <li><strong>Domain name:</strong> renewed yearly with your registrar</li>
          <li><strong>Text messages and phone number</strong> (for missed-call text-back): based on how many you send</li>
          <li><strong>Your job or accounting software</strong>, if you use any</li>
        </ul>
        <p class="strong">We'll estimate these for you before you start.</p>
      </div>
      <div class="card card--hover" data-reveal style="--reveal-delay:180ms">
        <h2 class="h3">What's not included</h2>
        <ul class="plain">
          <li>Photography (we can use your photos, or simple graphics)</li>
          <li>Logo design</li>
          <li>Paid advertising or ongoing SEO work</li>
          <li>Guaranteed Google rankings, enquiries or jobs. Nobody can honestly promise those.</li>
        </ul>
      </div>
      <div class="card card--hover own" data-reveal style="--reveal-delay:270ms">
        <h2 class="h3">Ownership</h2>
        <p class="muted">You own your domain, your content and your accounts. Once your project is paid for, the website built for you is yours. If you leave Website Care, we'll move your site to your own hosting account.</p>
      </div>
    </div>
  </section>

  <Faq items={pricingFaqs} tone="white" />
  <CtaBand heading="Want a price for your business?" text="" call={false} />
</BaseLayout>

<style>
  .founding {
    display: flex; gap: 14px; align-items: flex-start; max-width: 760px;
    background: rgba(245, 165, 36, .1); border: 1px solid rgba(245, 165, 36, .45); border-radius: 14px; padding: 18px 20px;
    color: var(--on-dark);
  }
  .founding strong { color: var(--white); }
  .founding-tag { flex: 0 0 auto; background: var(--amber); color: var(--ink-900); font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; margin-top: 2px; }

  .tiers { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); }
  .tier {
    position: relative; background: var(--white); border: 2px solid var(--border); border-radius: 16px; padding: 34px 30px 30px;
    display: flex; flex-direction: column; scroll-margin-top: 110px;
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease, background-color .22s ease;
  }
  .tier.featured, .tier:hover, .tier:focus-within, .tier:target { border-color: var(--amber); background: var(--amber-tint); box-shadow: var(--shadow-lift); }
  .tier:hover { transform: translateY(-6px); }
  .tiers:hover .tier.featured:not(:hover) { border-color: var(--border); background: var(--white); box-shadow: none; }
  .badge { position: absolute; top: -13px; left: 28px; background: var(--amber); color: var(--ink-900); font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; }
  .tier-name { font-size: 14px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--text-2); }
  .tier-label { margin-top: 16px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .tier-price { font-size: 52px; font-weight: 900; line-height: 1.05; margin-bottom: 18px; }
  dl { margin: 0 0 24px; display: grid; gap: 14px; font-size: 16px; padding-top: 18px; border-top: 1px solid var(--border); flex: 1; }
  dt { font-weight: 800; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  dd { margin: 2px 0 0; }
  .tier-actions { display: flex; flex-wrap: wrap; gap: 14px 22px; align-items: center; }

  .table-wrap { position: relative; overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius-card); background: var(--white); box-shadow: var(--shadow); }
  table { width: 100%; min-width: 600px; border-collapse: collapse; font-size: 15px; }
  th, td { padding: 15px 20px; text-align: left; vertical-align: top; border-top: 1px solid var(--border); }
  thead th { border-top: 0; background: var(--ink-900); color: var(--white); font-size: 13px; letter-spacing: .1em; text-transform: uppercase; font-weight: 800; }
  tbody tr:hover th, tbody tr:hover td { background: #fbf3e4; }
  tbody th { font-weight: 700; }
  tbody th a { color: var(--text); }
  tbody th a:hover { color: var(--amber-ink); }
  td { color: var(--text-2); }
  .p { font-weight: 800; color: var(--amber-ink); white-space: nowrap; }

  .care-block { margin-top: 64px; scroll-margin-top: 110px; }
  .care { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); max-width: 820px; }
  .care-card a {
    display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: var(--text);
    background: var(--paper); border: 2px solid var(--border); border-radius: 16px; padding: 24px 26px;
    transition: transform .22s ease, border-color .22s ease, background-color .22s ease, box-shadow .22s ease;
  }
  .care-card a:hover { transform: translateY(-5px); border-color: var(--amber); background: var(--amber-tint); box-shadow: var(--shadow-lift); }
  .care-name { font-size: 14px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--text-2); }
  .care-price { font-size: 40px; font-weight: 900; line-height: 1.15; }
  .care-price span { font-size: 15px; font-weight: 700; color: var(--muted); margin-left: 4px; }
  .care-more { font-weight: 800; font-size: 14px; color: var(--amber-ink); margin-top: 6px; }
  .note { margin-top: 16px; color: var(--text-2); font-weight: 600; }

  .fine { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); align-items: stretch; }
  .h3 { font-size: 19px; font-weight: 800; text-transform: uppercase; letter-spacing: .02em; margin-bottom: 12px; }
  .plain { margin: 10px 0 14px; padding-left: 20px; display: grid; gap: 8px; color: var(--text-2); line-height: 1.55; }
  .plain strong { color: var(--text); }
  .strong { font-weight: 700; }

  @media (max-width: 560px) { .p { white-space: normal; } .founding { flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) { .tier:hover, .care-card a:hover { transform: none; } }
</style>
