---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Page not found | Pilot Systems" description="This page doesn't exist or has moved." noindex>
  <section class="section msg">
    <div class="container narrow">
      <p class="kicker">Error 404</p>
      <h1 class="h2">This page has gone walkabout.</h1>
      <p class="lead">The page you're looking for doesn't exist or has moved. Try one of these instead:</p>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/services">What we do</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <a class="btn btn--primary" href="/contact">{site.cta}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .msg { min-height: 60vh; }
  .narrow { max-width: 760px; }
  .h2 { font-size: clamp(34px, 5vw, 56px); margin-bottom: 20px; }
  ul { margin: 0 0 28px; padding-left: 20px; display: grid; gap: 8px; font-weight: 700; font-size: 17px; }
</style>
