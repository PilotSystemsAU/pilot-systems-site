---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Pilot Systems" description="That page doesn't exist. Head back to the Pilot Systems homepage or get in touch about websites and automations for tradies." noindex>
  <section class="section msg">
    <div class="container narrow">
      <p class="kicker">Error 404</p>
      <h1 class="h2">That page doesn't exist</h1>
      <p class="lead">The link might be old, or the address might have a typo.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Go to the homepage</a>
        <a class="btn btn--outline" href="/contact">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .msg { min-height: 60vh; display: flex; align-items: center; }
  .narrow { max-width: 760px; }
  .h2 { font-size: clamp(34px, 5vw, 56px); margin-bottom: 20px; }
  .btn-row { margin-top: 28px; }
</style>
