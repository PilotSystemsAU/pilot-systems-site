---
import BaseLayout from '../layouts/BaseLayout.astro';
import TierComparisonTable from '../components/TierComparisonTable.astro';
import AutomationCatalogue from '../components/AutomationCatalogue.astro';
---

<BaseLayout title="What We Do | Pilot Systems" description="Websites and practical automations for Australian trade businesses.">
  <main>
    <section class="page-hero" aria-labelledby="page-title">
      <div class="hero-inner">
        <p class="kicker">Pilot Systems services</p>
        <h1 id="page-title">What we do</h1>
        <p class="intro">Websites that make your trade business easier to trust and contact, plus practical automations that keep work moving after the enquiry arrives.</p>
        <a class="button button-primary" href="/contact">Talk about your business</a>
      </div>
    </section>

    <TierComparisonTable />
    <AutomationCatalogue />
  </main>
</BaseLayout>

<style>
  .page-hero { background: #fff; color: #181532; font-family: Montserrat, Arial, sans-serif; padding: 6rem 1.5rem; }
  .hero-inner { margin: 0 auto; max-width: 1040px; }
  .kicker { color: #181582; font-size: .74rem; font-weight: 800; letter-spacing: .12em; line-height: 1.35; margin: 0; text-transform: uppercase; }
  h1 { font-size: clamp(3rem, 7vw, 5.65rem); letter-spacing: -.065em; line-height: .98; margin: .65rem 0 1.15rem; text-transform: uppercase; }
  .intro { color: #4a455c; font-size: clamp(1.02rem, 1.8vw, 1.2rem); line-height: 1.7; margin: 0 0 1.7rem; max-width: 720px; }
  .button { align-items: center; border: 1px solid #4a455c; border-radius: .45rem; display: inline-flex; font-size: .78rem; font-weight: 800; justify-content: center; letter-spacing: .035em; min-height: 2.85rem; padding: .75rem 1.05rem; text-decoration: none; text-transform: uppercase; transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .2s ease; }
  .button-primary { background: #4a455c; color: #fff; }
  .button-primary:hover { background: #181582; border-color: #181582; transform: translateY(-1px); }
  @media (max-width: 900px) { .page-hero { padding: 4.5rem 1.25rem; } }
  @media (max-width: 480px) { .page-hero { padding-inline: 1rem; } h1 { font-size: 3rem; } .button { width: 100%; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; } }
</style>
