---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';

// Cloudflare Turnstile site key (public by design). The secret key lives in Vercel.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '0x4AAAAAAFO08JJwJUhDeGDc';

type Field = { id: string; label: string; type: 'text' | 'tel' | 'email'; autocomplete?: string; inputmode?: 'text' | 'tel' | 'email'; hint?: string; required: boolean; max: number; error: string; invalid?: string };
// `max` matches the limits the server enforces in /api/enquiry.
const fields: Field[] = [
  { id: 'name', label: 'Your name', type: 'text', autocomplete: 'name', required: true, max: 100, error: 'Please add your name.' },
  { id: 'phone', label: 'Best number to reach you', type: 'tel', autocomplete: 'tel', inputmode: 'tel', required: true, max: 30, error: 'Please add your phone number.', invalid: 'That number looks too short. Please check it.' },
  { id: 'email', label: 'Email', type: 'email', autocomplete: 'email', required: false, max: 200, error: "That email doesn't look right. Please check it." },
  { id: 'trade', label: 'Your trade', type: 'text', hint: 'e.g. electrician', required: true, max: 100, error: 'Please add your trade.' },
  { id: 'suburb', label: "Suburb you're based in", type: 'text', autocomplete: 'address-level2', required: true, max: 100, error: 'Please add your suburb.' },
];
---

<BaseLayout
  title="Contact Pilot Systems | Book a Free Discovery Call"
  description="Book a free 15–25 minute discovery call with Pilot Systems. Call 0457 471 392 or send an enquiry. We aim to reply within 24 hours."
>
  <PageHero
    kicker="Contact"
    title="Book a free discovery call"
    intro="A 15–25 minute chat about your business, how you handle enquiries, and what would actually help. Afterwards, we'll send you a recommendation. Free, and no obligation."
  />

  <section class="section">
    <div class="container grid">
      <div class="side">
        <div class="card call" data-reveal>
          <h2 class="h3">Easiest way: give me a call</h2>
          <a class="btn btn--primary call-btn" href={site.phoneHref}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
            {site.phoneDisplay}
          </a>
          <p class="muted">If I'm on another call, leave a message or send the form.</p>
        </div>

        <div class="next" data-reveal style="--reveal-delay:100ms">
          <h2 class="h3">What happens next</h2>
          <ol class="steps" role="list">
            <li><span class="n" aria-hidden="true">1</span><p><strong>We aim to reply within 24 hours</strong> to set up a time.</p></li>
            <li><span class="n" aria-hidden="true">2</span><p><strong>We talk for 15–25 minutes</strong> by phone or video.</p></li>
            <li><span class="n" aria-hidden="true">3</span><p><strong>We send you a recommendation:</strong> what would help, and what it would cost. No obligation.</p></li>
          </ol>
        </div>

        <div class="other" data-reveal style="--reveal-delay:200ms">
          <p>Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p class="muted">Based in {site.location} · Working with tradies Australia-wide</p>
        </div>
      </div>

      <form
        class="card form"
        id="enquiry-form"
        action="/api/enquiry"
        method="post"
        novalidate
        data-phone={site.phoneDisplay}
        data-email={site.email}
      >
        <h2 class="h3">Or send an enquiry</h2>

        {fields.map((f) => (
          <div class="field">
            <label for={f.id}>
              {f.label}{' '}<span class:list={['req', { opt: !f.required }]}>{f.required ? 'Required' : 'Optional'}</span>
            </label>
            {f.hint && <p class="hint" id={`${f.id}-hint`}>{f.hint}</p>}
            <input
              id={f.id}
              name={f.id}
              type={f.type}
              autocomplete={f.autocomplete}
              inputmode={f.inputmode}
              maxlength={f.max}
              required={f.required}
              aria-describedby={[f.hint ? `${f.id}-hint` : '', `${f.id}-error`].filter(Boolean).join(' ')}
            />
            <p class="error" id={`${f.id}-error`} data-msg={f.error} data-msg-invalid={f.invalid} hidden></p>
          </div>
        ))}

        <div class="field">
          <label for="message">What do you need help with? <span class="req">Required</span></label>
          <p class="hint" id="message-hint">e.g. "I need a website", "I keep missing calls", "Not sure, want to talk it through"</p>
          <textarea id="message" name="message" rows="5" maxlength="3000" required aria-describedby="message-hint message-error"></textarea>
          <p class="error" id="message-error" data-msg="Please add what you need help with." hidden></p>
        </div>

        <!-- Honeypot: hidden from people, bots tend to fill it in -->
        <div class="hp" aria-hidden="true">
          <label for="company_website">Leave this field empty</label>
          <input id="company_website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <!-- One ID per enquiry, so a repeat send of the same enquiry is only delivered once -->
        <input type="hidden" name="submission_id" id="submission_id" />

        <div class="field spam">
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" data-size="flexible" data-response-field-name="cf-turnstile-response"></div>
          <p class="hint">This quick check stops spam. It usually finishes on its own.</p>
        </div>

        <p class="consent">We use your details to respond to your enquiry. They're handled by our hosting, spam-protection and email providers, including in the United States. Please don't include passwords, payment details, health information or other sensitive information. Sending an enquiry doesn't sign you up to marketing. See our <a href="/privacy">Privacy Policy</a>.</p>

        <button class="btn btn--primary submit" type="submit">Send my enquiry</button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  // Enquiry form behaviour:
  // - checks fields in the browser (the server checks them again)
  // - can only send once at a time, and every enquiry carries an ID so a repeat
  //   send of the same enquiry is only delivered once (see /api/enquiry)
  // - shows plain-English messages, never raw technical errors, and never says
  //   "sent" unless the server confirmed it
  // - keeps a draft in this tab only (sessionStorage), so going Back, a reload or
  //   the phone unloading the tab doesn't lose what was typed. The draft is
  //   deleted after a successful send and when the tab is closed.
  type Field = HTMLInputElement | HTMLTextAreaElement;

  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('.submit')!;
    const idField = form.querySelector<HTMLInputElement>('#submission_id')!;
    const phone = form.dataset.phone ?? '';
    const email = form.dataset.email ?? '';
    const SEND_LABEL = button.textContent?.trim() || 'Send my enquiry';
    const TIMEOUT_MS = 20000;
    const DRAFT_KEY = 'pilot-enquiry-draft';
    const msg = {
      check: 'Please check the highlighted fields.',
      offline: `You seem to be offline. Your details are still here. Please try again when you have signal, or call ${phone}.`,
      timeout: `Sending is taking too long. Your details are still here, so please try again in a moment, or call ${phone}.`,
      failed: `Sorry, that didn't send. Please call ${phone} or email ${email} and we'll sort it out.`,
      spamWait: `The spam check hasn't finished yet. Please wait a few seconds and press Send again. If this keeps happening, call ${phone} or email ${email}.`,
      spamFailed: "The spam check didn't go through. Please wait a moment for it to finish, then press Send again.",
    };

    const emailOk = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
    const newId = () => {
      if (crypto.randomUUID) return crypto.randomUUID();
      const b = crypto.getRandomValues(new Uint8Array(16));
      return Array.from(b, (x) => x.toString(16).padStart(2, '0')).join('');
    };

    const inputs = Array.from(form.querySelectorAll<Field>('.field input, .field textarea')).filter((el) => el.id !== 'company_website' && el.type !== 'hidden');

    // ---- draft (this tab only) ----
    const draft = {
      read(): Record<string, string> | null {
        try { return JSON.parse(sessionStorage.getItem(DRAFT_KEY) ?? 'null'); } catch { return null; }
      },
      save() {
        try {
          const d: Record<string, string> = { submission_id: idField.value };
          inputs.forEach((el) => (d[el.id] = el.value));
          sessionStorage.setItem(DRAFT_KEY, JSON.stringify(d));
        } catch { /* storage blocked: the form still works, it just won't remember */ }
      },
      clear() {
        try { sessionStorage.removeItem(DRAFT_KEY); } catch { /* ignore */ }
      },
    };
    const saved = draft.read();
    if (saved) {
      inputs.forEach((el) => { if (!el.value && typeof saved[el.id] === 'string') el.value = saved[el.id]; });
      if (!idField.value && saved.submission_id) idField.value = saved.submission_id;
    }
    if (!idField.value) idField.value = newId();
    inputs.forEach((el) => el.addEventListener('input', draft.save));

    // ---- field checks ----
    const setError = (el: Field, text: string) => {
      const err = document.getElementById(`${el.id}-error`);
      el.setAttribute('aria-invalid', String(Boolean(text)));
      if (err) { err.hidden = !text; err.textContent = text; }
    };
    const check = (el: Field) => {
      const err = document.getElementById(`${el.id}-error`);
      const v = el.value.trim();
      let text = '';
      if (el.required && !v) text = err?.dataset.msg ?? 'Please fill this in.';
      else if (el.type === 'email' && v && !emailOk(v)) text = err?.dataset.msg ?? 'Please check this.';
      else if (el.type === 'tel' && v && v.replace(/\D/g, '').length < 8) text = err?.dataset.msgInvalid || err?.dataset.msg || 'Please check this.';
      setError(el, text);
      return !text;
    };
    inputs.forEach((el) => {
      el.addEventListener('blur', () => el.value && check(el));
      el.addEventListener('input', () => el.getAttribute('aria-invalid') === 'true' && check(el));
    });

    // ---- sending ----
    let sending = false;
    // What was in the form on the last attempt that didn't confirm. A retry of
    // the same details keeps the same enquiry ID (so it can't arrive twice);
    // if they've changed the details since, it's a new enquiry with a new ID.
    let lastAttempt = '';
    const snapshot = () => inputs.map((el) => el.value.trim()).join('\u0000');
    const setBusy = (busy: boolean) => {
      button.disabled = busy;
      button.setAttribute('aria-disabled', String(busy));
      button.textContent = busy ? 'Sending…' : SEND_LABEL;
    };
    const showMessage = (text: string, failed = true) => {
      status.textContent = text;
      status.classList.toggle('fail', failed);
    };
    const resetSpamCheck = () => {
      // Turnstile adds this global once its script has loaded
      const ts = (window as Window & { turnstile?: { reset?: () => void } }).turnstile;
      try { ts?.reset?.(); } catch { /* ignore */ }
    };
    const finishWith = (text: string) => {
      sending = false;
      setBusy(false);
      showMessage(text);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return; // a second tap or Enter while sending does nothing

      const results = inputs.map(check);
      if (results.includes(false)) {
        inputs[results.indexOf(false)].focus();
        showMessage(msg.check, false);
        return;
      }
      const token = (form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value ?? '').trim();
      if (!token) {
        showMessage(msg.spamWait);
        return;
      }
      if (!navigator.onLine) {
        showMessage(msg.offline);
        return;
      }

      const now = snapshot();
      if (lastAttempt && lastAttempt !== now) idField.value = newId();
      lastAttempt = now;

      sending = true;
      setBusy(true);
      showMessage('', false);
      draft.save();

      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), TIMEOUT_MS);
      let res: Response;
      let data: { ok?: boolean; error?: string; fields?: string[] } = {};
      try {
        res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
          signal: controller.signal,
        });
        data = await res.json().catch(() => ({}));
      } catch {
        // Network dropped or took too long. The same enquiry ID is kept, so
        // trying again can't create a second enquiry if the first got through.
        resetSpamCheck();
        return finishWith(controller.signal.aborted ? msg.timeout : navigator.onLine ? msg.failed : msg.offline);
      } finally {
        window.clearTimeout(timer);
      }

      if (res.ok && data.ok) {
        // Clear personal details before leaving, so Back doesn't show them again.
        draft.clear();
        form.reset();
        idField.value = newId();
        lastAttempt = '';
        window.location.assign('/thanks');
        return; // stay "sending" until the next page loads
      }

      resetSpamCheck();
      if (data.error === 'invalid' && Array.isArray(data.fields)) {
        let first: Field | null = null;
        for (const el of inputs) {
          if (data.fields.includes(el.id)) {
            const err = document.getElementById(`${el.id}-error`);
            const v = el.value.trim();
            const text = !v ? err?.dataset.msg : el.type === 'tel' ? err?.dataset.msgInvalid : el.type === 'email' ? err?.dataset.msg : '';
            setError(el, text || 'Please check this.');
            first ??= el;
          }
        }
        finishWith(msg.check);
        first?.focus();
        return;
      }
      finishWith(data.error === 'spam_check_failed' ? msg.spamFailed : msg.failed);
    });

    // Coming Back to this page from the browser's memory (bfcache): make the
    // button usable again and get a fresh spam-check token.
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      sending = false;
      setBusy(false);
      showMessage('', false);
      resetSpamCheck();
    });
  }
</script>

<style>
  .grid { display: grid; gap: 40px; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: start; }
  .side { display: grid; gap: 34px; }
  .h3 { font-size: 20px; font-weight: 800; text-transform: uppercase; letter-spacing: .02em; margin-bottom: 14px; }
  .call { border: 2px solid var(--amber); background: var(--amber-tint); }
  .call-btn { width: 100%; font-size: 20px; min-height: 60px; margin-bottom: 14px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .steps li { display: flex; gap: 14px; align-items: flex-start; }
  .n { flex: 0 0 32px; height: 32px; border-radius: 50%; background: var(--ink-900); color: var(--amber); font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .steps p { color: var(--text-2); padding-top: 4px; }
  .steps strong { color: var(--text); }
  .other p { margin-bottom: 4px; }

  .form { padding: clamp(22px, 3vw, 34px); }
  /* More space between fields than inside one, so each label clearly belongs to its own input */
  .field { margin-bottom: 24px; }
  /* Label and its Required/Optional tag flow as one line of text. On a narrow phone the tag
     wraps with the last word instead of dropping onto its own floating row. */
  label { display: block; font-weight: 700; line-height: 1.35; margin-bottom: 8px; }
  .req { display: inline-block; margin-left: 4px; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; vertical-align: 1px; color: var(--amber-ink); }
  .req.opt { color: var(--muted); }
  .hint { font-size: 14px; color: var(--muted); margin-bottom: 6px; }
  input, textarea {
    width: 100%;
    font: 400 16px/1.5 var(--font);
    color: var(--text);
    background: var(--white);
    border: 1.5px solid #9a93a8;
    border-radius: var(--radius);
    padding: 12px 14px;
    min-height: 48px;
    transition: border-color .18s ease, box-shadow .18s ease;
    /* When a phone keyboard opens, leave room to see the field's error message */
    scroll-margin-block: 90px 72px;
  }
  /* Stop the browser's autofill tint (pale yellow) clashing with the form */
  input:-webkit-autofill { -webkit-box-shadow: 0 0 0 1000px var(--white) inset; -webkit-text-fill-color: var(--text); }
  input:hover, textarea:hover { border-color: var(--plum); }
  input:focus-visible, textarea:focus-visible { outline: 3px solid var(--amber); outline-offset: 1px; border-color: var(--amber-ink); }
  [aria-invalid='true'] { border-color: #b3261e; }
  .error { color: #b3261e; font-size: 14px; font-weight: 600; margin-top: 6px; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .spam { margin-top: 4px; }
  .consent { font-size: 14px; color: var(--text-2); margin: 6px 0 18px; }
  .submit { width: 100%; }
  .submit:disabled { opacity: .7; cursor: progress; }
  .status { margin-top: 14px; font-weight: 600; }
  .status.fail { color: #b3261e; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
