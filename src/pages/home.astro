---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroFlow from "../components/HeroFlow.astro";
import SoundsLikeYou from "../components/SoundsLikeYou.astro";
import WhatWeOffer from "../components/WhatWeOffer.astro";
import HowItWorks from "../components/HowItWorks.astro";
import PilotAutomations from "../components/PilotAutomations.astro";
import TransparencyCosts from "../components/TransparencyCosts.astro";
import GetInTouch from "../components/GetInTouch.astro";
---

<BaseLayout
  title="Pilot Systems — Websites & Simple Systems for Aussie Tradies"
  description="Websites and practical automations for Australian tradies who want more control, less admin and clearer days."
>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Melbourne-based. Built for Aussie tradies.</p>

        <h1>
          <span class="headline-line">SIMPLE SYSTEMS.</span>
          <span class="headline-line">CLEARER DAYS.</span>
        </h1>

        <p class="hero-description">
          Fast websites for Aussie tradies, plus practical automations that
          move enquiries, quotes, bookings and admin forward—without adding
          another complicated system to manage.
        </p>

        <div class="hero-actions">
          <a href="tel:0457471392" class="button button-primary">
            CALL NOW
          </a>

          <a href="/services" class="button button-secondary">
            SEE WHAT WE AUTOMATE
          </a>
        </div>
      </div>

      <div class="hero-flow-column">
        <HeroFlow />
      </div>
    </div>
  </section>

  <section class="trade-banner" aria-label="Trades we work with">
