  <style>
    .hero {
      display: flex;
      min-height: 650px;
      padding: 5rem 1.5rem;
      align-items: center;
      overflow: hidden;
      background: #f8f8f8;
    }

    .hero-inner {
      width: min(100%, 1240px);
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(2rem, 4vw, 4rem);
    }

    .hero-text,
    .hero-flow-column {
      min-width: 0;
    }

    .hero-text {
      overflow-wrap: anywhere;
    }

    .hero-text h1 {
      max-width: 10ch;
      margin: 0 0 1.5rem;
      color: #181532;
      font-size: clamp(2.7rem, 3.8vw, 4.2rem);
      font-weight: 700;
      letter-spacing: 0.01em;
      line-height: 0.98;
    }

    .headline-line {
      display: block;
    }

    .eyebrow,
    .section-eyebrow {
      margin: 0 0 1.25rem;
      color: #4a455c;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .hero-description {
      max-width: 560px;
      margin: 0 0 1.75rem;
      color: #4a455c;
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
    }

    .button {
      display: inline-flex;
      min-height: 44px;
      padding: 0.55rem 1rem;
      align-items: center;
      justify-content: center;
      border-radius: 0.45rem;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.035em;
      line-height: 1;
      text-align: center;
      text-decoration: none;
      text-transform: uppercase;
      transition:
        background-color 0.18s ease-out,
        border-color 0.18s ease-out,
        color 0.18s ease-out,
        transform 0.18s ease-out;
    }

    .button-primary {
      color: #ffffff;
      background: #4a455c;
      border: 1px solid #4a455c;
    }

    .button-primary:hover,
    .button-primary:focus-visible {
      background: #181582;
      border-color: #181582;
      transform: translateY(-2px);
    }

    .button-secondary {
      color: #4a455c;
      background: transparent;
      border: 1px solid #4a455c;
    }

    .button-secondary:hover,
    .button-secondary:focus-visible {
      color: #181582;
      background: #ffffff;
      border-color: #181582;
      transform: translateY(-2px);
    }

    .trade-banner {
  padding: 1rem 0;
  overflow: hidden;
  color: #ffffff;
  background: #151029;
}

.trade-banner-viewport {
  width: 100%;
  overflow: hidden;
}

.trade-banner-track {
  --trade-group-gap: 1.35rem;
  display: flex;
  width: max-content;
  gap: var(--trade-group-gap);
  will-change: transform;
  animation: trade-scroll 40s linear infinite;
}

.trade-banner-group {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 1.35rem;
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
}

.trade-dot {
  color: #ffffff;
  font-size: 1.3rem;
  line-height: 1;
  opacity: 0.8;
}

@keyframes trade-scroll {
  from {
    transform: translate3d(0, 0, 0);
  }

  to {
    transform: translate3d(
      calc(-25% - (var(--trade-group-gap) * 0.25)),
      0,
      0
    );
  }
}

    .automation-overview {
      padding: 6rem 1.5rem;
      background: #ffffff;
    }

    .automation-overview-inner {
      width: min(100%, 1240px);
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
      gap: clamp(2.5rem, 6vw, 6rem);
      align-items: start;
    }

    .automation-overview-intro {
      position: sticky;
      top: 7rem;
    }

    .automation-overview-intro h2 {
      max-width: 13ch;
      margin: 0;
      color: #181532;
      font-size: clamp(2rem, 3.3vw, 3.25rem);
      line-height: 1.05;
      text-transform: uppercase;
    }

    .automation-overview-intro > p:not(.section-eyebrow) {
      max-width: 44ch;
      margin: 1.25rem 0 0;
      color: #4a455c;
      font-size: 1rem;
    }

    .text-link {
      display: inline-flex;
      margin-top: 1.5rem;
      align-items: center;
      gap: 0.5rem;
      color: #181582;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .text-link:hover,
    .text-link:focus-visible {
      color: #4a455c;
    }

    .text-link span {
      font-size: 1.15rem;
      transition: transform 0.18s ease-out;
    }

    .text-link:hover span,
    .text-link:focus-visible span {
      transform: translateX(4px);
    }

    .automation-list {
      display: grid;
      border-top: 1px solid #e1e1ed;
    }

    .automation-item {
      display: grid;
      padding: 1.5rem 0;
      grid-template-columns: 3rem minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
      gap: 1rem;
      border-bottom: 1px solid #e1e1ed;
    }

    .automation-number {
      margin: 0;
      color: #181582;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    .automation-item h3 {
      margin: 0;
      color: #181532;
      font-size: 1rem;
      line-height: 1.35;
      text-transform: uppercase;
    }

    .automation-item > p:last-child {
      margin: 0;
      color: #686277;
      font-size: 0.92rem;
      line-height: 1.6;
    }

    @media (max-width: 1050px) {
      .hero-inner {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 2rem;
      }

      .hero-text h1 {
        font-size: clamp(2.5rem, 5vw, 3.6rem);
      }
    }

    @media (max-width: 900px) {
      .hero {
        min-height: auto;
        padding: 4.5rem 1.25rem;
      }

      .hero-inner {
        grid-template-columns: minmax(0, 1fr);
        gap: 3rem;
      }

      .hero-text h1 {
        max-width: none;
        font-size: clamp(2.4rem, 10vw, 3.3rem);
      }

      .hero-description {
        font-size: 1rem;
      }

      .trade-banner-track {
  --trade-group-gap: 1rem;
}

      .trade-banner-group {
  gap: 1rem;
  font-size: 0.8rem;
}


      .automation-overview {
        padding: 4.5rem 1.25rem;
      }

      .automation-overview-inner {
        grid-template-columns: minmax(0, 1fr);
        gap: 3rem;
      }

      .automation-overview-intro {
        position: static;
      }

      .automation-overview-intro h2 {
        max-width: 16ch;
      }
    }

    @media (max-width: 600px) {
      .automation-item {
        grid-template-columns: 2.5rem minmax(0, 1fr);
        gap: 0.75rem;
      }

      .automation-item > p:last-child {
        grid-column: 2;
      }
    }

    @media (max-width: 480px) {
      .hero {
        padding-inline: 1rem;
      }

      .hero-actions {
        display: grid;
      }

      .button {
        width: 100%;
      }

      .automation-overview {
        padding-inline: 1rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .trade-banner-track {
        width: auto;
        animation: none;
      }

      .trade-banner-group[aria-hidden="true"] {
        display: none;
      }

      .trade-banner-group {
        width: 100%;
        padding: 0 1rem;
        justify-content: center;
        flex-wrap: wrap;
        white-space: normal;
      }

      .button,
      .text-link span {
        transition: none;
      }
    }
  </style>
</BaseLayout>