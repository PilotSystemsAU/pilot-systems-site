---
const bundles = [
  {
    number: "01",
    name: "Lead Capture Pack",
    outcome: "Respond to and organise every enquiry",
    items: [
      "Enquiry routing",
      "Instant acknowledgement",
      "Missed-call response",
      "Lead source tracking",
    ],
  },
  {
    number: "02",
    name: "Quote Conversion Pack",
    outcome: "Stop good quotes from going cold",
    items: [
      "Quote follow-ups",
      "Acceptance workflow",
      "Expiry workflow",
      "Sales-task reminders",
    ],
  },
  {
    number: "03",
    name: "Job Communication Pack",
    outcome: "Keep customers and staff informed",
    items: [
      "Booking confirmation",
      "Reminders",
      "On-the-way alerts",
      "Status updates",
    ],
  },
  {
    number: "04",
    name: "Cashflow Pack",
    outcome: "Invoice faster and reduce chasing",
    items: [
      "Completion-to-invoice handoff",
      "Deposit requests",
      "Overdue reminders",
      "Payment confirmation",
    ],
  },
  {
    number: "05",
    name: "Reputation Pack",
    outcome: "Generate genuine feedback and referrals",
    items: [
      "Review request",
      "Feedback follow-up",
      "Testimonial permission",
      "Referral request",
    ],
  },
  {
    number: "06",
    name: "Operations Pack",
    outcome: "Reduce internal admin and lost information",
    items: [
      "Daily digest",
      "Document filing",
      "Dashboard",
      "Staff notifications",
      "Recurring-job reminders",
    ],
  },
];
---

<section class="pilot-automations" aria-labelledby="automations-title">
  <div class="section-inner">
    <div class="section-heading">
      <div>
        <p class="kicker">PRACTICAL WORKFLOWS, NOT MORE SOFTWARE</p>
        <h2 id="automations-title">PILOT AUTOMATIONS</h2>
      </div>

      <p class="intro-copy">
        Choose a bundle around the bottleneck in your business, or select
        individual automations from the full catalogue.
      </p>
    </div>

    <div class="bundle-grid">
      {
        bundles.map((bundle) => (
          <details class="bundle-card">
            <summary>
              <span class="bundle-topline">
                <span class="bundle-number">{bundle.number}</span>
                <span class="bundle-toggle" aria-hidden="true">+</span>
              </span>

              <h3>{bundle.name}</h3>
              <p class="bundle-outcome">{bundle.outcome}</p>
              <span class="reveal-label">VIEW INCLUDED AUTOMATIONS</span>
            </summary>

            <div class="bundle-details">
              <p class="included-label">INCLUDED AUTOMATIONS</p>

              <ul>
                {bundle.items.map((item) => <li>{item}</li>)}
              </ul>

              <p class="pricing-note">
                Automations from $500 each — placeholder pricing.
              </p>
            </div>
          </details>
        ))
      }
    </div>

    <div class="automation-footer">
      <p>
        Every workflow is scoped around your current process, tools and
        approval rules. Individual automations can also be selected outside a
        bundle.
      </p>

      <a href="/contact" class="button button-primary">
        TALK TO US ABOUT AUTOMATIONS
      </a>
    </div>
  </div>
</section>

<style>
  .pilot-automations {
    padding: 6rem 1.5rem;
    background: #151029;
  }

  .section-inner {
    width: min(100%, 1100px);
    margin: 0 auto;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.8fr);
    align-items: end;
    gap: 2rem;
  }

  .kicker,
  .bundle-number,
  .reveal-label,
  .included-label {
    margin: 0;
    color: #bcb8d0;
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 0.5rem 0 0;
    color: #ffffff;
    font-size: clamp(2rem, 4vw, 3.35rem);
    letter-spacing: 0.035em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .intro-copy {
    margin: 0;
    color: #d0cddd;
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .bundle-grid {
    display: grid;
    margin-top: 2.75rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .bundle-card {
    overflow: hidden;
    background: #211b39;
    border: 1px solid #48405f;
    border-radius: 0.75rem;
    transition:
      border-color 0.18s ease-out,
      transform 0.18s ease-out,
      box-shadow 0.18s ease-out;
  }

  .bundle-card:hover,
  .bundle-card[open] {
    border-color: #8981ba;
    box-shadow: 0 18px 35px rgba(0, 0, 0, 0.2);
    transform: translateY(-3px);
  }

  .bundle-card summary {
    display: block;
    min-height: 240px;
    padding: 1.35rem;
    cursor: pointer;
    list-style: none;
  }

  .bundle-card summary::-webkit-details-marker {
    display: none;
  }

  .bundle-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .bundle-number {
    color: #b5b0d4;
  }

  .bundle-toggle {
    display: grid;
    width: 27px;
    height: 27px;
    place-items: center;
    color: #ffffff;
    background: #181582;
    border-radius: 50%;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.18s ease-out;
  }

  .bundle-card[open] .bundle-toggle {
    transform: rotate(45deg);
  }

  .bundle-card h3 {
    margin: 2.25rem 0 0;
    color: #ffffff;
    font-size: 1.15rem;
    letter-spacing: 0;
    line-height: 1.3;
    text-transform: none;
  }

  .bundle-outcome {
    margin: 0.65rem 0 0;
    color: #d0cddd;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .reveal-label {
    display: block;
    margin-top: 1.25rem;
    color: #a9a4c0;
    font-size: 0.63rem;
  }

  .bundle-details {
    padding: 0 1.35rem 1.35rem;
  }

  .included-label {
    padding-top: 1rem;
    color: #b5b0d4;
    border-top: 1px solid #48405f;
  }

  .bundle-details ul {
    display: grid;
    margin: 0.8rem 0 0;
    padding: 0;
    gap: 0.55rem;
    list-style: none;
  }

  .bundle-details li {
    position: relative;
    padding-left: 1.15rem;
    color: #f0eff7;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .bundle-details li::before {
    position: absolute;
    top: 0.48rem;
    left: 0;
    width: 6px;
    height: 6px;
    content: "";
    background: #8b84d0;
    border-radius: 50%;
  }

  .pricing-note {
    margin: 1.1rem 0 0;
    padding-top: 0.95rem;
    color: #bcb8d0;
    border-top: 1px solid #48405f;
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .automation-footer {
    display: flex;
    margin-top: 2rem;
    padding-top: 1.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-top: 1px solid #48405f;
  }

  .automation-footer p {
    max-width: 680px;
    margin: 0;
    color: #d0cddd;
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .button {
    display: inline-flex;
    min-height: 44px;
    padding: 0.65rem 1rem;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border: 1px solid transparent;
    border-radius: 0.45rem;
    font-family: inherit;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.035em;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.18s ease-out,
      transform 0.18s ease-out;
  }

  .button-primary {
    color: #ffffff;
    background: #4a455c;
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    background: #181582;
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .pilot-automations {
      padding: 4.5rem 1.25rem;
    }

    .section-heading {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .bundle-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .bundle-grid {
      grid-template-columns: 1fr;
    }

    .bundle-card summary {
      min-height: 210px;
    }

    .automation-footer {
      align-items: stretch;
      flex-direction: column;
    }

    .automation-footer .button {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .pilot-automations {
      padding-inline: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bundle-card,
    .bundle-toggle,
    .button {
      transition: none;
    }
  }
</style>