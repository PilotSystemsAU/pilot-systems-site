---
const offerItems = [
  {
    label: "Fast, mobile-optimised",
    icon: "bolt",
  },
  {
    label: "Built for SEO",
    icon: "search",
  },
  {
    label: "Your design, not a template",
    icon: "layout",
  },
  {
    label: "Generates real leads",
    icon: "lead",
  },
  {
    label: "No admin headaches",
    icon: "check",
  },
  {
    label: "Built on Astro & Next.js",
    icon: "code",
  },
  {
    label: "Secure by default",
    icon: "shield",
  },
  {
    label: "Accessibility built in",
    icon: "accessibility",
  },
];
---

<section class="what-we-offer" aria-labelledby="what-we-offer-title">
  <div class="section-inner">
    <div class="offer-heading">
      <div>
        <p class="kicker">BUILT PROPERLY FROM THE START</p>
        <h2 id="what-we-offer-title">WHAT WE OFFER</h2>
      </div>

      <a href="/services" class="button button-secondary">
        SEE OUR SERVICES
      </a>
    </div>

    <div class="offer-grid">
      {
        offerItems.map((item) => (
          <article class="offer-item">
            <span class="offer-icon" aria-hidden="true">
              {item.icon === "bolt" && (
                <svg viewBox="0 0 24 24">
                  <path d="m13 2-9 12h7l-1 8 9-12h-7z"></path>
                </svg>
              )}

              {item.icon === "search" && (
                <svg viewBox="0 0 24 24">
                  <circle cx="11" cy="11" r="6.5"></circle>
                  <path d="m16 16 4 4"></path>
                </svg>
              )}

              {item.icon === "layout" && (
                <svg viewBox="0 0 24 24">
                  <rect x="3" y="4" width="18" height="16" rx="1"></rect>
                  <path d="M3 9h18M9 9v11"></path>
                </svg>
              )}

              {item.icon === "lead" && (
                <svg viewBox="0 0 24 24">
                  <path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5c-1.3 0-2.5-0.3-3.5-0.9L4 20l1.5-4.1A7.5 7.5 0 1 1 20 11.5z"></path>
                  <path d="m9 11.5 2 2 4-4"></path>
                </svg>
              )}

              {item.icon === "check" && (
                <svg viewBox="0 0 24 24">
                  <path d="m5 12 4 4L19 6"></path>
                </svg>
              )}

              {item.icon === "code" && (
                <svg viewBox="0 0 24 24">
                  <path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 4l-4 16"></path>
                </svg>
              )}

              {item.icon === "shield" && (
                <svg viewBox="0 0 24 24">
                  <path d="M12 3 20 6v5c0 5-3.4 8.3-8 10-4.6-1.7-8-5-8-10V6z"></path>
                  <path d="m8.5 12 2.2 2.2 4.8-4.8"></path>
                </svg>
              )}

              {item.icon === "accessibility" && (
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="4.5" r="1.8"></circle>
                  <path d="M5 8.5h14M12 8.5v12M8.5 21l3.5-6 3.5 6M8.5 11.5 5.5 16M15.5 11.5l3 4.5"></path>
                </svg>
              )}
            </span>

            <p>{item.label}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .what-we-offer {
    padding: 4.5rem 1.5rem;
    background: #f8f8fb;
    border-top: 1px solid #e1e1ed;
    border-bottom: 1px solid #e1e1ed;
  }

  .section-inner {
    width: min(100%, 1100px);
    margin: 0 auto;
  }

  .offer-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .kicker {
    margin: 0;
    color: #777289;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .offer-heading h2 {
    margin: 0.5rem 0 0;
    color: #181532;
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    letter-spacing: 0.035em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .offer-grid {
    display: grid;
    margin-top: 2rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .offer-item {
    display: flex;
    min-height: 130px;
    padding: 1rem;
    flex-direction: column;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid #deddea;
    border-radius: 0.65rem;
  }

  .offer-icon {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    color: #181582;
    background: #ecebf7;
    border-radius: 0.45rem;
  }

  .offer-icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .offer-item p {
    margin: 1rem 0 0;
    color: #181532;
    font-size: 0.83rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .button {
    display: inline-flex;
    min-height: 42px;
    padding: 0.62rem 0.95rem;
    align-items: center;
    justify-content: center;
    border: 1px solid #4a455c;
    border-radius: 0.45rem;
    font-family: inherit;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.035em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      border-color 0.18s ease-out,
      color 0.18s ease-out,
      transform 0.18s ease-out;
  }

  .button-secondary {
    color: #4a455c;
    background: transparent;
  }

  .button-secondary:hover,
  .button-secondary:focus-visible {
    color: #181582;
    border-color: #181582;
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .what-we-offer {
      padding: 4.5rem 1.25rem;
    }

    .offer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .offer-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .offer-heading .button {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .what-we-offer {
      padding-inline: 1rem;
    }

    .offer-grid {
      grid-template-columns: 1fr;
    }

    .offer-item {
      min-height: 108px;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 1rem;
    }

    .offer-item p {
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }
</style>