---
import LogoMark from '../assets/logo-mark-light.svg';
import { site, nav } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header on-dark">
  <div class="container bar">
    <a href="/" class="brand" aria-label="Pilot Systems home">
      <LogoMark class="brand-mark" aria-hidden="true" />
      <span class="brand-name">PILOT SYSTEMS</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul id="site-menu" class="nav-list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li class="nav-cta-mobile">
          <a class="btn btn--light" href="/contact">{site.cta}</a>
        </li>
      </ul>
    </nav>

    <div class="actions">
      <a class="phone" href={site.phoneHref}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
        <span class="phone-text">{site.phoneDisplay}</span>
        <span class="sr-only">Call Pilot Systems</span>
      </a>
      <a class="btn btn--light btn--sm header-cta" href="/contact">{site.cta}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu">
        <span class="sr-only">Menu</span>
        <svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('site-menu');
  if (btn && menu) {
    const close = () => {
      btn.setAttribute('aria-expanded', 'false');
      menu.classList.remove('open');
    };
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      menu.classList.toggle('open', !open);
      if (!open) menu.querySelector('a')?.focus();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('open')) {
        close();
        btn.focus();
      }
    });
    window.matchMedia('(min-width: 961px)').addEventListener('change', close);
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--navy-800);
    border-bottom: 1px solid #2a2350;
    color: var(--white);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 76px;
  }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--white); text-decoration: none; }
  .brand :global(.brand-mark) { width: 46px; height: auto; }
  .brand-name { font-weight: 800; font-size: 17px; letter-spacing: 0.12em; white-space: nowrap; }

  .nav-list { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  .nav-list a { color: var(--on-dark); text-decoration: none; font-weight: 600; font-size: 15px; }
  .nav-list a:hover, .nav-list a[aria-current='page'] { color: var(--white); }
  .nav-list a[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; }
  .nav-cta-mobile { display: none; }

  .actions { display: flex; align-items: center; gap: 18px; }
  .phone { display: flex; align-items: center; gap: 8px; color: var(--white); text-decoration: none; font-weight: 700; font-size: 15px; white-space: nowrap; }
  .phone svg { color: var(--lav); }
  .phone:hover { color: var(--lav); }
  .menu-btn {
    display: none;
    width: 44px; height: 44px;
    align-items: center; justify-content: center;
    background: transparent; color: var(--white);
    border: 1px solid #3a3270; border-radius: var(--radius);
    cursor: pointer;
  }
  .icon-close { display: none; }
  .menu-btn[aria-expanded='true'] .icon-open { display: none; }
  .menu-btn[aria-expanded='true'] .icon-close { display: block; }

  @media (max-width: 1100px) {
    .phone-text { display: none; }
    .phone { width: 44px; height: 44px; justify-content: center; border: 1px solid #3a3270; border-radius: var(--radius); }
  }

  @media (max-width: 960px) {
    .menu-btn { display: inline-flex; }
    .header-cta { display: none; }
    .nav { position: static; }
    .nav-list {
      display: none;
      position: absolute;
      left: 0; right: 0; top: 100%;
      flex-direction: column;
      gap: 0;
      background: var(--navy-800);
      border-bottom: 1px solid #2a2350;
      padding: 8px var(--gutter) 20px;
    }
    .nav-list.open { display: flex; }
    .nav-list li a { display: block; padding: 14px 0; font-size: 18px; border-bottom: 1px solid #2a2350; }
    .nav-cta-mobile { display: block; padding-top: 16px; }
    .nav-list .nav-cta-mobile a { display: flex; border-bottom: 0; padding: 15px 22px; font-size: 14px; color: var(--indigo); }
  }

  @media (max-width: 420px) {
    .brand-name { font-size: 15px; letter-spacing: 0.08em; }
    .brand :global(.brand-mark) { width: 34px; }
    .actions { gap: 10px; }
  }
</style>
