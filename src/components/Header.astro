---
import LogoMark from '../assets/logo-mark-light.svg';
import { site, nav } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header on-dark">
  <div class="container bar">
    <a href="/" class="brand" aria-label="Pilot Systems home">
      <LogoMark class="brand-mark" aria-hidden="true" />
      <span class="brand-name">PILOT SYSTEMS</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul id="site-menu" class="nav-list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li class="nav-cta-mobile">
          <a class="btn btn--primary" href="/contact">{site.cta}</a>
        </li>
      </ul>
    </nav>

    <div class="actions">
      <a class="phone" href={site.phoneHref}>
        <span class="phone-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
        </span>
        <span class="phone-text">{site.phoneDisplay}</span>
        <span class="sr-only">Call Pilot Systems</span>
      </a>
      <a class="btn btn--primary btn--sm header-cta" href="/contact">Book a free call</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu">
        <span class="sr-only">Menu</span>
        <svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('site-menu');
  if (btn && menu) {
    const close = () => {
      btn.setAttribute('aria-expanded', 'false');
      menu.classList.remove('open');
    };
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      menu.classList.toggle('open', !open);
      if (!open) menu.querySelector('a')?.focus();
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('open')) {
        close();
        btn.focus();
      }
    });
    window.matchMedia('(min-width: 961px)').addEventListener('change', close);
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(28, 23, 38, .96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--ink-700);
    color: var(--white);
  }
  /* Three columns: logo | centred menu | actions */
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    min-height: 76px;
  }
  .brand { justify-self: start; display: flex; align-items: center; gap: 10px; color: var(--on-dark); text-decoration: none; }
  .brand :global(.brand-mark) { width: 46px; height: auto; }
  .brand-name { font-weight: 800; font-size: 17px; letter-spacing: 0.12em; white-space: nowrap; color: var(--on-dark); }
  .brand:hover .brand-name { color: var(--white); }

  .nav { justify-self: center; }
  .nav-list { display: flex; gap: 30px; list-style: none; margin: 0; padding: 0; }
  .nav-list a { color: var(--on-dark); text-decoration: none; font-weight: 600; font-size: 15px; position: relative; padding: 6px 0; }
  .nav-list a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
    background: var(--amber); transform: scaleX(0); transform-origin: left; transition: transform .22s ease;
  }
  .nav-list a:hover { color: var(--white); }
  .nav-list a:hover::after, .nav-list a[aria-current='page']::after { transform: scaleX(1); }
  .nav-list a[aria-current='page'] { color: var(--white); }
  .nav-cta-mobile { display: none; }

  .actions { justify-self: end; display: flex; align-items: center; gap: 18px; }
  .header-cta { white-space: nowrap; }
  .phone { display: flex; align-items: center; gap: 8px; color: var(--white); text-decoration: none; font-weight: 700; font-size: 15px; white-space: nowrap; }
  .phone-icon { display: inline-flex; color: var(--amber); transition: transform .2s ease; }
  .phone:hover { color: var(--amber-soft); }
  .phone:hover .phone-icon, .phone:focus-visible .phone-icon { animation: ring .7s ease-in-out; transform: scale(1.18); }
  @keyframes ring {
    0% { transform: scale(1.18) rotate(0); }
    15% { transform: scale(1.18) rotate(-14deg); }
    30% { transform: scale(1.18) rotate(12deg); }
    45% { transform: scale(1.18) rotate(-10deg); }
    60% { transform: scale(1.18) rotate(8deg); }
    75% { transform: scale(1.18) rotate(-4deg); }
    100% { transform: scale(1.18) rotate(0); }
  }
  .menu-btn {
    display: none;
    width: 44px; height: 44px;
    align-items: center; justify-content: center;
    background: transparent; color: var(--white);
    border: 1px solid var(--ink-700); border-radius: var(--radius);
    cursor: pointer;
  }
  .icon-close { display: none; }
  .menu-btn[aria-expanded='true'] .icon-open { display: none; }
  .menu-btn[aria-expanded='true'] .icon-close { display: block; }

  @media (max-width: 1150px) {
    .phone-text { display: none; }
    .phone { width: 44px; height: 44px; justify-content: center; border: 1px solid var(--ink-700); border-radius: var(--radius); }
  }

  @media (max-width: 960px) {
    /* Phone/tablet: header scrolls away with the page, slimmer, all items centred */
    .site-header { position: relative; backdrop-filter: none; background: var(--ink-900); }
    .bar { display: flex; align-items: center; justify-content: space-between; min-height: 62px; gap: 12px; }
    .menu-btn { display: inline-flex; }
    .header-cta { display: none; }
    .nav { position: static; }
    .nav-list {
      display: none;
      position: absolute;
      left: 0; right: 0; top: 100%;
      flex-direction: column;
      gap: 0;
      background: var(--ink-900);
      border-bottom: 1px solid var(--ink-700);
      padding: 8px var(--gutter) 20px;
    }
    .nav-list.open { display: flex; }
    .nav-list li a { display: block; padding: 14px 0; font-size: 18px; border-bottom: 1px solid var(--ink-700); }
    .nav-list li a::after { display: none; }
    .nav-cta-mobile { display: block; padding-top: 16px; }
    .nav-list .nav-cta-mobile a { display: flex; border-bottom: 0; padding: 15px 22px; font-size: 14px; color: var(--ink-900); }
  }

  @media (max-width: 700px) {
    .phone { display: none; }
    .brand :global(.brand-mark) { width: 36px; }
    .brand-name { font-size: 15px; }
  }

  @media (max-width: 420px) {
    .brand-name { font-size: 15px; letter-spacing: 0.08em; }
    .brand :global(.brand-mark) { width: 36px; }
    .actions { gap: 10px; }
  }
</style>
