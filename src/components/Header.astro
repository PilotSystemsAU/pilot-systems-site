---
const phoneDisplay = "0457 471 392";
const phoneLink = "0457471392";
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Pilot Systems home">
      <img
        src="/logo-pilot-systems.png"
        alt=""
        class="logo-image"
        width="36"
        height="36"
      />
      <span class="logo-text">PILOT SYSTEMS</span>
    </a>

    <nav class="nav" aria-label="Primary navigation">
      <a href="/services" class="nav-link">What we do</a>
      <a href="/showroom" class="nav-link">Showroom</a>
      <a href="/pricing" class="nav-link">Pricing</a>
      <a href="/contact" class="nav-link">Contact</a>

      <div class="nav-dropdown">
        <button
          type="button"
          class="nav-link nav-toggle"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>More</span>
          <span class="nav-arrow" aria-hidden="true">▾</span>
        </button>

        <div class="nav-dropdown-menu">
          <a href="/who-we-are" class="nav-link">Who we are</a>
          <a href="/who-we-help" class="nav-link">Who we help</a>
          <a href="/testimonials" class="nav-link">Testimonials</a>
          <a href="/blog" class="nav-link">Blog</a>
        </div>
      </div>
    </nav>

    <div class="header-actions">
      <a
        href={`tel:${phoneLink}`}
        class="phone"
        aria-label={`Call Pilot Systems on ${phoneDisplay}`}
      >
        <video
          class="phone-icon-video"
          src="/phone-shake.webm"
          muted
          playsinline
          aria-hidden="true"
        ></video>
        <span class="phone-text">{phoneDisplay}</span>
      </a>

      <a href="/contact" class="button button-primary">
        FREE CONSULTATION
      </a>
    </div>
  </div>

  <style>
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: #f8f8fb;
      border-bottom: 1px solid #e1e1ed;
    }

    .header-inner {
      width: min(100% - 3rem, 1400px);
      margin: 0 auto;
      padding: 1rem 0;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 2rem;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      justify-self: start;
      gap: 0.6rem;
      color: #2d2b38;
      text-decoration: none;
      white-space: nowrap;
    }

    .logo-image {
      display: block;
      width: 36px;
      height: 36px;
      object-fit: contain;
    }

    .logo-text {
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .nav {
      display: flex;
      align-items: center;
      justify-self: center;
      gap: 2rem;
      font-size: 1rem;
      font-weight: 500;
    }

    .nav-link {
      position: relative;
      padding-bottom: 0.12rem;
      color: #4a455c;
      font: inherit;
      text-decoration: none;
      white-space: nowrap;
    }

    .nav-link::after {
      position: absolute;
      bottom: -0.15rem;
      left: 0;
      width: 0;
      height: 2px;
      content: "";
      background-color: #181582;
      transition: width 0.18s ease-out;
    }

    .nav-link:hover,
    .nav-link:focus-visible {
      color: #181582;
    }

    .nav-link:hover::after,
    .nav-link:focus-visible::after {
      width: 100%;
    }

    .nav-dropdown {
      position: relative;
    }

    .nav-dropdown::after {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      height: 14px;
      content: "";
    }

    .nav-toggle {
      display: inline-flex;
      padding-inline: 0;
      align-items: center;
      gap: 0.35rem;
      cursor: pointer;
      border: 0;
      background: transparent;
    }

    .nav-arrow {
      display: inline-block;
      transform: rotate(180deg);
      transform-origin: center;
      transition: transform 0.18s ease-out;
    }

    .nav-dropdown:hover .nav-arrow,
    .nav-dropdown:focus-within .nav-arrow {
      transform: rotate(0deg);
    }

    .nav-dropdown-menu {
      position: absolute;
      top: calc(100% + 10px);
      left: 50%;
      z-index: 60;
      display: flex;
      min-width: 190px;
      padding: 0.75rem;
      flex-direction: column;
      gap: 0.35rem;
      opacity: 0;
      pointer-events: none;
      background: #ffffff;
      border: 1px solid #e1e1ed;
      border-radius: 0.5rem;
      box-shadow: 0 12px 28px rgba(24, 21, 130, 0.12);
      transform: translate(-50%, 4px);
      transition:
        opacity 0.16s ease-out,
        transform 0.16s ease-out;
    }

    .nav-dropdown-menu .nav-link {
      padding: 0.45rem 0.35rem;
    }

    .nav-dropdown:hover .nav-dropdown-menu,
    .nav-dropdown:focus-within .nav-dropdown-menu {
      opacity: 1;
      pointer-events: auto;
      transform: translate(-50%, 0);
    }

    .header-actions {
      display: flex;
      align-items: center;
      justify-self: end;
      gap: 1rem;
      white-space: nowrap;
    }

    .phone {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      color: #4a455c;
      font-size: 1rem;
      font-weight: 600;
      text-decoration: none;
      transform: translateX(6px);
    }

    .phone:hover,
    .phone:focus-visible {
      color: #181582;
    }

    .phone-icon-video {
      display: block;
      width: 30px;
      height: 30px;
      object-fit: contain;
      pointer-events: none;
    }

    .button {
      display: inline-flex;
      min-height: 38px;
      padding: 0.45rem 0.9rem;
      align-items: center;
      justify-content: center;
      border-radius: 0.45rem;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.035em;
      line-height: 1;
      text-align: center;
      text-decoration: none;
      text-transform: uppercase;
      white-space: nowrap;
      transition:
        background-color 0.18s ease-out,
        color 0.18s ease-out,
        transform 0.18s ease-out;
    }

    .button-primary {
      color: #ffffff;
      background: #4a455c;
    }

    .button-primary:hover,
    .button-primary:focus-visible {
      background: #181582;
      transform: translateY(-1px);
    }

    @media (max-width: 1100px) {
      .header-inner {
        width: min(100% - 2rem, 1400px);
        grid-template-columns: 1fr auto;
      }

      .nav {
        grid-column: 1 / -1;
        grid-row: 2;
        justify-self: center;
      }
    }

    @media (max-width: 700px) {
      .header-inner {
        display: flex;
        padding: 0.9rem 0;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.85rem;
      }

      .logo {
        justify-content: center;
      }

      .header-actions {
        justify-content: center;
      }

      .nav {
        width: 100%;
        order: 3;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.85rem 1.1rem;
        font-size: 0.92rem;
      }

      .phone {
        transform: none;
      }

      .phone-icon-video {
        width: 26px;
        height: 26px;
      }

      .button {
        min-height: 38px;
        padding: 0.45rem 0.8rem;
        font-size: 0.72rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .nav-link::after,
      .nav-arrow,
      .nav-dropdown-menu,
      .button {
        transition: none;
      }
    }
  </style>
</header>

<script>
  const video = document.querySelector<HTMLVideoElement>(".phone-icon-video");
  const phoneLink = document.querySelector<HTMLAnchorElement>(".phone");

  if (video && phoneLink) {
    let isHovering = false;
    let replayTimer: ReturnType<typeof setTimeout> | undefined;

    const stopPhoneAnimation = () => {
      isHovering = false;

      if (replayTimer) {
        clearTimeout(replayTimer);
        replayTimer = undefined;
      }

      video.pause();
      video.currentTime = 0;
    };

    const startPhoneAnimation = () => {
      isHovering = true;

      if (replayTimer) {
        clearTimeout(replayTimer);
        replayTimer = undefined;
      }

      video.currentTime = 0;
      video.play().catch(() => {});
    };

    video.addEventListener("ended", () => {
      if (!isHovering) return;

      replayTimer = setTimeout(() => {
        if (!isHovering) return;

        video.currentTime = 0;
        video.play().catch(() => {});
      }, 500);
    });

    phoneLink.addEventListener("mouseenter", startPhoneAnimation);
    phoneLink.addEventListener("mouseleave", stopPhoneAnimation);
    phoneLink.addEventListener("focus", startPhoneAnimation);
    phoneLink.addEventListener("blur", stopPhoneAnimation);
  }

  const dropdown = document.querySelector<HTMLElement>(".nav-dropdown");
  const dropdownButton =
    document.querySelector<HTMLButtonElement>(".nav-toggle");

  if (dropdown && dropdownButton) {
    dropdown.addEventListener("mouseenter", () => {
      dropdownButton.setAttribute("aria-expanded", "true");
    });

    dropdown.addEventListener("mouseleave", () => {
      dropdownButton.setAttribute("aria-expanded", "false");
    });

    dropdown.addEventListener("focusin", () => {
      dropdownButton.setAttribute("aria-expanded", "true");
    });

    dropdown.addEventListener("focusout", () => {
      window.setTimeout(() => {
        if (!dropdown.contains(document.activeElement)) {
          dropdownButton.setAttribute("aria-expanded", "false");
        }
      }, 0);
    });

    dropdownButton.addEventListener("click", () => {
      const isExpanded =
        dropdownButton.getAttribute("aria-expanded") === "true";

      dropdownButton.setAttribute(
        "aria-expanded",
        isExpanded ? "false" : "true",
      );
    });
  }
</script>