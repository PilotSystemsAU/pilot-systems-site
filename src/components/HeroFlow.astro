---
const steps = [
  {
    number: "01",
    title: "Your website builds trust",
    description:
      "Fast, mobile-friendly pages make your services clear and make it easy for the right customers to contact you.",
    status: "FOUNDATION",
    icon: "search",
    delay: "0s",
  },
  {
    number: "02",
    title: "Enquiries go to the right place",
    description:
      "Quote forms can capture job details, qualify requests and send leads into your inbox, CRM or job system.",
    status: "LEADS",
    icon: "form",
    delay: "2.4s",
  },
  {
    number: "03",
    title: "Follow-up keeps work moving",
    description:
      "Choose instant replies, missed-call texts, quote follow-ups, lead alerts or booking reminders.",
    status: "AUTOMATED",
    icon: "message",
    delay: "4.8s",
  },
  {
    number: "04",
    title: "Admin happens with less chasing",
    description:
      "Add customer updates, invoice handoffs, review requests, reminders and practical reporting when needed.",
    status: "CONNECTED",
    icon: "job",
    delay: "7.2s",
  },
];
---

<div class="flow-wrap">
  <div class="lead-notification" aria-hidden="true">
    <svg viewBox="0 0 24 24">
      <path d="m5 12 4 4L19 6"></path>
    </svg>
    Workflow connected
  </div>

  <article class="flow-card" aria-labelledby="flow-title">
    <header class="flow-header">
      <div>
        <p class="flow-kicker">YOUR WEBSITE + WORKFLOW</p>
        <h2 id="flow-title">FROM SEARCH TO FOLLOW-UP</h2>
      </div>

      <span class="live-status">
        <span aria-hidden="true"></span>
        LIVE FLOW
      </span>
    </header>

    <div class="flow-steps">
      <div class="flow-track" aria-hidden="true"></div>

      {
        steps.map((step) => (
          <section
            class="flow-step"
            style={`--step-delay: ${step.delay}`}
          >
            <div class="step-icon" aria-hidden="true">
              {
                step.icon === "search" && (
                  <svg viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m20 20-4-4M11 8v6M8 11h6"></path>
                  </svg>
                )
              }

              {
                step.icon === "form" && (
                  <svg viewBox="0 0 24 24">
                    <path d="M4 4h16v16H4zM4 9h16M9 20V9"></path>
                    <path d="m13 14 2 2 4-4"></path>
                  </svg>
                )
              }

              {step.icon === "message" && (
  <svg viewBox="0 0 24 24">
    <path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5c-1.3 0-2.5-0.3-3.5-0.9L4 20l1.5-4.1A7.5 7.5 0 1 1 20 11.5z"></path>
    <path d="m9 11.5 2 2 4-4"></path>
  </svg>
)}

              {
                step.icon === "job" && (
                  <svg viewBox="0 0 24 24">
                    <path d="M3 21h18M5 21V10l7-5 7 5v11M9 21v-6h6v6"></path>
                    <path d="m16 8 2-5 2 5"></path>
                  </svg>
                )
              }
            </div>

            <div class="step-copy">
              <p class="step-number">STEP {step.number}</p>
              <h3>{step.title}</h3>
              <p class="step-description">{step.description}</p>
            </div>

            <span class="step-status">{step.status}</span>
          </section>
        ))
      }
    </div>

    <footer class="flow-result">
      <div>
        <p>BUILT AROUND YOUR BUSINESS</p>
        <strong>MORE CONTROL. LESS ADMIN. CLEARER DAYS.</strong>
      </div>

      <span class="result-check" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="m5 12 4 4L19 6"></path>
        </svg>
      </span>
    </footer>
  </article>
</div>

<style>
  .flow-wrap {
    position: relative;
    min-width: 0;
  }

  .flow-card {
    position: relative;
    overflow: hidden;
    padding: 1.35rem;
    background: #ffffff;
    border: 1px solid #deddea;
    border-radius: 0.75rem;
    box-shadow:
      0 2px 4px rgba(24, 21, 50, 0.04),
      0 18px 48px rgba(24, 21, 130, 0.1);
  }

  .flow-card::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    content: "";
    pointer-events: none;
    background: linear-gradient(
      135deg,
      rgba(24, 21, 130, 0.045),
      transparent 38%
    );
  }

  .flow-card > * {
    position: relative;
    z-index: 1;
  }

  .flow-header {
    display: flex;
    padding-bottom: 1rem;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid #e7e6ef;
  }

  .flow-kicker,
  .step-number,
  .flow-result p {
    margin: 0;
    color: #777289;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .flow-header h2 {
    margin: 0.25rem 0 0;
    color: #181532;
    font-size: 1.22rem;
    font-weight: 700;
    letter-spacing: 0.025em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .live-status {
    display: inline-flex;
    padding: 0.3rem 0.55rem;
    align-items: center;
    flex: 0 0 auto;
    gap: 0.4rem;
    color: #181582;
    background: #e9e8f5;
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    line-height: 1;
  }

  .live-status > span {
    width: 6px;
    height: 6px;
    background: #181582;
    border-radius: 50%;
    animation: live-pulse 1.7s ease-in-out infinite;
  }

  .flow-steps {
    position: relative;
    display: grid;
    padding: 1.1rem 0;
    gap: 0.45rem;
  }

  .flow-track {
    position: absolute;
    top: calc(1.1rem + 23px);
    bottom: calc(1.1rem + 23px);
    left: 23px;
    width: 2px;
    overflow: hidden;
    background: #deddea;
  }

  .flow-track::after {
    position: absolute;
    inset: -40% 0 auto;
    height: 34%;
    content: "";
    background: linear-gradient(
      to bottom,
      transparent,
      #181582,
      transparent
    );
    animation: track-travel 4.8s linear infinite;
  }

  .flow-step {
    position: relative;
    display: grid;
    min-height: 76px;
    margin-left: -0.80rem;
    padding: 0.45rem 0.6rem 0.45rem 0;
    grid-template-columns: 46px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    border-radius: 0.55rem;
    animation: step-highlight 9.6s var(--step-delay) ease-in-out infinite;
  }

  .step-icon {
    position: relative;
    z-index: 2;
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    color: #4a455c;
    background: #f1f0f7;
    border: 1px solid #deddea;
    border-radius: 0.5rem;
    animation: icon-highlight 9.6s var(--step-delay) ease-in-out infinite;
  }

  .step-icon svg,
  .lead-notification svg,
  .result-check svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .step-copy {
    min-width: 0;
  }

  .flow-step h3 {
    margin: 0.15rem 0 0;
    color: #181532;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
    text-transform: none;
  }

  .step-description {
    margin: 0.18rem 0 0;
    color: #686277;
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .step-status {
    color: #181582;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .flow-result {
    display: flex;
    padding: 0.9rem 1rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: #ffffff;
    background: #151029;
    border-radius: 0.55rem;
  }

  .flow-result p {
    color: #c6c3d7;
  }

  .flow-result strong {
    display: block;
    margin-top: 0.18rem;
    font-size: 0.82rem;
    letter-spacing: 0.025em;
    line-height: 1.35;
  }

  .result-check {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    flex: 0 0 auto;
    color: #ffffff;
    background: #181582;
    border-radius: 50%;
    animation: check-pop 4.8s 3.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .lead-notification {
    position: absolute;
    top: 31%;
    right: -1.1rem;
    z-index: 3;
    display: inline-flex;
    padding: 0.7rem 0.8rem;
    align-items: center;
    gap: 0.45rem;
    color: #181532;
    background: #ffffff;
    border: 1px solid #deddea;
    border-radius: 0.5rem;
    box-shadow: 0 12px 28px rgba(24, 21, 130, 0.13);
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
    animation: notification-float 4s ease-in-out infinite;
  }

  .lead-notification svg {
    width: 17px;
    height: 17px;
    color: #181582;
  }

  @keyframes live-pulse {
    50% {
      opacity: 0.25;
    }
  }

  @keyframes track-travel {
    from {
      transform: translateY(0);
    }

    to {
      transform: translateY(410%);
    }
  }

  @keyframes step-highlight {
    0%,
    17%,
    100% {
      background: transparent;
    }

    4%,
    13% {
      background: #efeff9;
    }
  }

  @keyframes icon-highlight {
    0%,
    17%,
    100% {
      color: #4a455c;
      background: #f1f0f7;
      transform: scale(1);
    }

    4%,
    13% {
      color: #181582;
      background: #e5e4f6;
      transform: scale(1.05);
    }
  }

  @keyframes check-pop {
    0%,
    78%,
    100% {
      transform: scale(1);
    }

    84% {
      transform: scale(1.14);
    }

    89% {
      transform: scale(1);
    }
  }

  @keyframes notification-float {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-7px);
    }
  }

  @media (max-width: 1100px) {
    .lead-notification {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .flow-card {
      padding: 1rem;
    }

    .flow-step {
      min-height: 72px;
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 0.7rem;
    }

    .step-icon {
      width: 42px;
      height: 42px;
    }

    .flow-track {
      left: 20px;
    }

    .step-status {
      display: none;
    }

    .step-description {
      max-width: 30ch;
    }

    .flow-result {
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-status > span,
    .flow-track::after,
    .flow-step,
    .step-icon,
    .result-check,
    .lead-notification {
      animation: none;
    }

    .flow-track::after {
      display: none;
    }
  }
</style>