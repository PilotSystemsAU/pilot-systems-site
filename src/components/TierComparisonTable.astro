---
type TierKey = 'presence' | 'lead' | 'hq';

type Feature = {
  name: string;
  presence: string;
  lead: string;
  hq: string;
};

type Group = {
  title: string;
  features: Feature[];
};

const tiers: { key: TierKey; name: string; positioning: string; price: string; warranty: string; revisions: string; pages: string }[] = [
  {
    key: 'presence',
    name: 'Pilot Presence',
    positioning: 'Affordable professional starting point for a sole trader or small team',
    price: '$1,500',
    warranty: '30-day defect warranty',
    revisions: 'Up to 2',
    pages: 'Up to 5'
  },
  {
    key: 'lead',
    name: 'Pilot Lead Engine',
    positioning: 'Conversion-focused site for established businesses that want to generate, qualify and measure leads',
    price: '$2,500',
    warranty: '30-day defect warranty',
    revisions: 'Up to 3',
    pages: 'Up to 10'
  },
  {
    key: 'hq',
    name: 'Pilot Digital HQ',
    positioning: 'Premium, bespoke platform with advanced functions and integration-ready foundations',
    price: '$5,000',
    warranty: '90-day defect warranty',
    revisions: 'Up to 4',
    pages: 'Up to 20'
  }
];

const groups: Group[] = [
  {
    title: 'Strategy & planning',
    features: [
      { name: 'Structured discovery session', presence: '✓ One session', lead: '✓ Deeper workshop', hq: '✓ Multiple stakeholder sessions' },
      { name: 'Written site brief & content checklist', presence: '✓', lead: '✓ Page-by-page objectives', hq: '✓ Full functional specification' },
      { name: 'Proposed sitemap', presence: '✓', lead: '✓', hq: '✓ Detailed information architecture' },
      { name: 'Customer journey mapping', presence: '✗', lead: '✓', hq: '✓' },
      { name: 'Keyword & local-intent research', presence: '✗', lead: '✓', hq: '✓ Expanded, multi-location' },
      { name: 'Conversion / measurement plan', presence: '✗', lead: '✓', hq: '✓' }
    ]
  },
  {
    title: 'Pages & content',
    features: [
      { name: 'Individual service pages', presence: '✗ Combined services page only', lead: '✓ Up to 5', hq: '✓ Multiple templates' },
      { name: 'Service-area landing pages', presence: '✗ Basic service-area info only', lead: '✓ Up to 3', hq: '✓ Multiple' },
      { name: 'Project/case study template', presence: '✗ Simple gallery only', lead: '✓', hq: '✓ Advanced library with filters' },
      { name: 'FAQ section', presence: '✗', lead: '✓', hq: '✓' },
      { name: 'Blog / resource centre', presence: '✗', lead: '✓ Blog index + template', hq: '✓ Full resource centre' },
      { name: 'Included copywriting', presence: '✗ Light edits of supplied text only', lead: '✓ Initial copywriting, defined allowance', hq: '✓ Strategic copywriting for key pages' },
      { name: 'Content migration', presence: '✗', lead: '✓ Up to 3 articles', hq: '✓ Up to 10 items' }
    ]
  },
  {
    title: 'Design',
    features: [
      { name: 'Custom tailored layout (not a template)', presence: '✓', lead: '✓', hq: '✓ Bespoke, wireframed first' },
      { name: 'Fully responsive (mobile/tablet/desktop)', presence: '✓', lead: '✓', hq: '✓' },
      { name: 'Custom section compositions beyond standard blocks', presence: '✗', lead: '✓', hq: '✓' },
      { name: 'Documented design system (colours, type, components)', presence: '✗', lead: '✗', hq: '✓' },
      { name: 'Accessibility review depth', presence: 'Basic foundations', lead: 'Extended review', hq: 'Targeted WCAG 2.2 AA review' }
    ]
  },
  {
    title: 'Content management',
    features: [
      { name: 'CMS / client editing access', presence: '✗', lead: '✓', hq: '✓' },
      { name: 'Editor training session', presence: '✗', lead: '✓', hq: '✓ Admin + content editor training' }
    ]
  },
  {
    title: 'Lead capture',
    features: [
      { name: 'Contact/quote form', presence: '✓ One standard form', lead: '✓ Multi-step or two standard forms', hq: '✓ As part of advanced functions' },
      { name: 'Conditional/qualification questions', presence: '✗', lead: '✓', hq: '✓' },
      { name: 'Photo/document upload', presence: '✗', lead: '✓ Optional', hq: '✓ Secure, with retention rules' },
      { name: 'Spam protection & validation', presence: '✓', lead: '✓', hq: '✓' },
      { name: 'Automation-ready webhook/integration endpoint', presence: '✗', lead: '✓', hq: '✓ Integration-ready APIs' }
    ]
  },
  {
    title: 'SEO & analytics',
    features: [
      { name: 'On-page SEO (titles, meta, sitemap, robots.txt)', presence: '✓', lead: '✓', hq: '✓' },
      { name: 'Structured data', presence: '✓ Basic LocalBusiness', lead: '✓ Expanded: Service/FAQ/Breadcrumb', hq: '✓ Full structured-data plan' },
      { name: 'Analytics setup', presence: '✗', lead: '✓', hq: '✓ Expanded dashboards' },
      { name: 'Search Console connection', presence: '✓', lead: '✓', hq: '✓' },
      { name: 'Conversion event tracking', presence: '✗', lead: '✓', hq: '✓' },
      { name: 'Technical SEO review', presence: '✗ Setup only', lead: '✓', hq: '✓ Full on-page mapping' },
      { name: '90-day post-launch performance review', presence: '✗', lead: '✗', hq: '✓' }
    ]
  },
  {
    title: 'Performance & security',
    features: [
      { name: 'Build architecture', presence: 'Astro (lightweight, static-first)', lead: 'Next.js', hq: 'Next.js + integrations' },
      { name: 'HTTPS', presence: '✓', lead: '✓', hq: '✓' },
      { name: 'Responsive image optimisation', presence: '✓', lead: '✓', hq: '✓' },
      { name: 'Staging + production environments', presence: '✗', lead: '✓', hq: '✓' },
      { name: 'Core Web Vitals / performance testing', presence: '✗', lead: '✓', hq: '✓ Major templates + functions' },
      { name: 'Security headers', presence: '✓ Basic, where supported', lead: '✓', hq: '✓ Least-privilege access, secrets management' },
      { name: 'Backup / rollback', presence: '✓ Source-control copy', lead: '✓', hq: '✓ Documented rollback procedure' }
    ]
  },
  {
    title: 'Launch & support',
    features: [
      { name: 'Domain/DNS/deployment', presence: '✓', lead: '✓', hq: '✓' },
      { name: 'Cross-device/browser testing', presence: '✓', lead: '✓', hq: '✓' },
      { name: 'Launch checklist & sign-off', presence: '✓', lead: '✓', hq: '✓' },
      { name: 'Defect warranty', presence: '30 days', lead: '30 days', hq: '90 days' },
      { name: 'Post-launch review', presence: '✗', lead: '✓ 30-day optimisation review', hq: '✓ 30-day and 90-day reviews' },
      { name: 'Optional care plan proposed', presence: '✓', lead: '✓', hq: '✓' }
    ]
  },
  {
    title: 'Advanced functions',
    features: [
      { name: 'Custom interactive component (calculator, wizard, booking, filters, etc.)', presence: '✗', lead: '✗', hq: '✓ One substantial or two smaller' },
      { name: 'Limited customer portal/account feature', presence: '✗', lead: '✗', hq: '✓' }
    ]
  }
];

const iconClass = (value: string) => value.startsWith('✓') ? 'included' : value.startsWith('✗') ? 'not-included' : 'text-only';
const displayValue = (value: string) => value.replace(/^[✓✗]\s*/, '');
---

<section class="tier-comparison" id="website-tiers" aria-labelledby="tier-comparison-title">
  <div class="section-inner">
    <div class="section-heading">
      <p class="kicker">Website packages</p>
      <h2 id="tier-comparison-title">Choose the foundation that fits where you are now.</h2>
      <p>Every website is designed for real trade businesses: clear, fast, easy to use and built around the next action you want customers to take.</p>
    </div>

    <div class="tier-summary" aria-label="Website tier overview">
      {tiers.map((tier) => (
        <article class={`summary-card ${tier.key === 'lead' ? 'is-featured' : ''}`}>
          <p class="tier-name">{tier.name}</p>
          <p class="positioning">{tier.positioning}</p>
          <div class="price-row">
            <span class="price">{tier.price}</span>
            <span class="price-note">Indicative — confirmed at enquiry</span>
          </div>
          <dl>
            <div><dt>Warranty</dt><dd>{tier.warranty}</dd></div>
            <div><dt>Revision rounds</dt><dd>{tier.revisions}</dd></div>
            <div><dt>Core pages</dt><dd>{tier.pages}</dd></div>
          </dl>
        </article>
      ))}
    </div>

    <div class="desktop-matrix">
      <table>
        <thead>
          <tr>
            <th scope="col">Feature</th>
            {tiers.map((tier) => <th scope="col">{tier.name}</th>)}
          </tr>
        </thead>
        <tbody>
          {groups.map((group) => (
            <>
              <tr class="group-row"><th scope="colgroup" colspan="4">{group.title}</th></tr>
              {group.features.map((feature) => (
                <tr>
                  <th scope="row">{feature.name}</th>
                  {tiers.map((tier) => {
                    const value = feature[tier.key];
                    const state = iconClass(value);
                    return (
                      <td class={state}>
                        {state !== 'text-only' && <span class="symbol" aria-hidden="true">{value.charAt(0)}</span>}
                        <span>{displayValue(value)}</span>
                      </td>
                    );
                  })}
                </tr>
              ))}
            </>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Layout judgement call: a native-details tier accordion replaces the four-column matrix below 700px so every inclusion remains readable without horizontal scrolling. -->
    <div class="mobile-tiers">
      {tiers.map((tier) => (
        <details class={`mobile-tier ${tier.key === 'lead' ? 'is-featured' : ''}`}>
          <summary>
            <span>{tier.name}</span>
            <span class="summary-price">{tier.price}</span>
          </summary>
          <div class="mobile-tier-content">
            <p>{tier.positioning}</p>
            <dl class="mobile-meta">
              <div><dt>Warranty</dt><dd>{tier.warranty}</dd></div>
              <div><dt>Revision rounds</dt><dd>{tier.revisions}</dd></div>
              <div><dt>Core pages</dt><dd>{tier.pages}</dd></div>
            </dl>
            {groups.map((group) => (
              <div class="feature-group">
                <h3>{group.title}</h3>
                <ul>
                  {group.features.map((feature) => {
                    const value = feature[tier.key];
                    const state = iconClass(value);
                    return (
                      <li class={state}>
                        <span class="symbol" aria-hidden="true">{state === 'text-only' ? '•' : value.charAt(0)}</span>
                        <span><strong>{feature.name}</strong>{displayValue(value) ? ` — ${displayValue(value)}` : ''}</span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </div>
        </details>
      ))}
    </div>

    <p class="fine-print">Pricing shown is indicative and confirmed at enquiry. A deposit is required to begin, with milestone payments through design, build and launch. Third-party costs — domain, hosting, subscriptions — are billed separately. Search rankings, traffic and lead volume are not guaranteed.</p>
  </div>
</section>

<style>
  .tier-comparison { background: #f8f8fb; padding: 6rem 1.5rem; color: #181532; font-family: Montserrat, Arial, sans-serif; }
  .section-inner { max-width: 1240px; margin: 0 auto; }
  .section-heading { max-width: 760px; margin-bottom: 2.75rem; }
  .kicker, .tier-name, dt { color: #181582; font-size: .74rem; font-weight: 800; letter-spacing: .12em; line-height: 1.35; text-transform: uppercase; }
  h2 { margin: .55rem 0 1rem; font-size: clamp(2rem, 4vw, 3.4rem); letter-spacing: -.045em; line-height: 1.06; }
  .section-heading > p:last-child { color: #4a455c; font-size: 1.02rem; line-height: 1.75; margin: 0; }
  .tier-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2rem; }
  .summary-card { background: #fff; border: 1px solid #e1e1ed; border-radius: .65rem; padding: 1.5rem; }
  .summary-card.is-featured { border-color: #181582; box-shadow: 0 12px 28px rgba(24, 21, 130, .08); }
  .tier-name { margin: 0 0 .75rem; }
  .positioning { color: #4a455c; font-size: .93rem; line-height: 1.58; min-height: 4.5rem; margin: 0 0 1.35rem; }
  .price-row { border-bottom: 1px solid #e1e1ed; margin-bottom: 1.15rem; padding-bottom: 1.1rem; }
  .price { color: #181532; display: block; font-size: 1.8rem; font-weight: 800; letter-spacing: -.04em; }
  .price-note { color: #777289; display: block; font-size: .72rem; line-height: 1.45; margin-top: .3rem; }
  dl { margin: 0; }
  dl > div { display: grid; gap: .2rem; margin-top: .75rem; }
  dt { color: #777289; font-size: .65rem; }
  dd { color: #4a455c; font-size: .86rem; line-height: 1.45; margin: 0; }
  .desktop-matrix { background: #fff; border: 1px solid #e1e1ed; border-radius: .65rem; overflow: hidden; }
  table { border-collapse: collapse; width: 100%; }
  th, td { border-bottom: 1px solid #e1e1ed; padding: 1rem 1.1rem; text-align: left; vertical-align: top; }
  thead th { background: #151029; color: #fff; font-size: .76rem; font-weight: 800; letter-spacing: .075em; text-transform: uppercase; }
  thead th:first-child { width: 28%; }
  tbody > tr:last-child td, tbody > tr:last-child th { border-bottom: 0; }
  tbody > tr:not(.group-row) th { color: #181532; font-size: .86rem; font-weight: 700; line-height: 1.45; }
  td { color: #686277; font-size: .8rem; line-height: 1.45; }
  .group-row th { background: #f8f8fb; border-top: 1px solid #deddea; color: #181582; font-size: .72rem; font-weight: 800; letter-spacing: .11em; padding: .85rem 1.1rem; text-transform: uppercase; }
  .symbol { display: inline-block; font-size: 1rem; font-weight: 800; line-height: 1; margin-right: .32rem; }
  .included .symbol { color: #181582; }
  .not-included { color: #777289; }
  .not-included .symbol { color: #c6c3d7; }
  .text-only { color: #4a455c; }
  .mobile-tiers { display: none; }
  .fine-print { color: #777289; font-size: .78rem; line-height: 1.65; margin: 1.25rem 0 0; max-width: 940px; }
  @media (max-width: 1100px) { .summary-card { padding: 1.25rem; } .positioning { min-height: 5.9rem; } th, td { padding: .85rem .75rem; } }
  @media (max-width: 900px) { .tier-comparison { padding: 4.5rem 1.25rem; } .tier-summary { gap: .75rem; } }
  @media (max-width: 700px) { .tier-summary, .desktop-matrix { display: none; } .mobile-tiers { display: grid; gap: .75rem; } .mobile-tier { background: #fff; border: 1px solid #e1e1ed; border-radius: .6rem; overflow: hidden; } .mobile-tier.is-featured { border-color: #181582; } summary { align-items: center; color: #181532; cursor: pointer; display: flex; font-size: .94rem; font-weight: 800; justify-content: space-between; list-style: none; padding: 1.1rem 1rem; } summary::-webkit-details-marker { display: none; } summary::after { color: #181582; content: '+'; font-size: 1.35rem; font-weight: 500; margin-left: .75rem; } details[open] summary::after { content: '−'; } .summary-price { color: #181582; font-size: .86rem; margin-left: auto; } .mobile-tier-content { border-top: 1px solid #e1e1ed; padding: 1rem; } .mobile-tier-content > p { color: #4a455c; font-size: .9rem; line-height: 1.6; margin: 0 0 1rem; } .mobile-meta { background: #f8f8fb; border-radius: .45rem; display: grid; gap: .75rem; grid-template-columns: repeat(3, 1fr); padding: .85rem; } .mobile-meta > div { margin: 0; } .mobile-meta dd { font-size: .76rem; } .feature-group { border-top: 1px solid #e1e1ed; margin-top: 1.2rem; padding-top: 1.2rem; } .feature-group h3 { color: #181582; font-size: .71rem; letter-spacing: .1em; margin: 0 0 .75rem; text-transform: uppercase; } .feature-group ul { display: grid; gap: .7rem; list-style: none; margin: 0; padding: 0; } .feature-group li { color: #686277; display: flex; font-size: .81rem; line-height: 1.5; } .feature-group li .symbol { flex: 0 0 1rem; margin-top: .15rem; } .feature-group strong { color: #181532; font-weight: 700; } }
  @media (max-width: 480px) { .tier-comparison { padding-inline: 1rem; } h2 { font-size: 2rem; } .mobile-meta { grid-template-columns: 1fr; } .mobile-meta > div { border-bottom: 1px solid #e1e1ed; padding-bottom: .55rem; } .mobile-meta > div:last-child { border-bottom: 0; padding-bottom: 0; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; } }
</style>
