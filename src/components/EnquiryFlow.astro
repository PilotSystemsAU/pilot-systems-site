---
// Animated example of one enquiry moving through a connected set-up.
// Steps light up in turn; with reduced motion, all steps show at once.
const steps = [
  { time: '7:42 am', title: 'New quote request', text: 'Hot water system, Box Hill. Photos attached.', icon: 'inbox' },
  { time: '7:42 am', title: 'Sarah gets an automatic reply', text: '"Thanks Sarah, we\'ll call you back today."', icon: 'reply' },
  { time: '12:10 pm', title: 'You get a reminder to call', text: 'Right when you stop for lunch.', icon: 'bell' },
  { time: '3 days later', title: 'Quote follow-up sent for you', text: 'No more quotes going quiet.', icon: 'repeat' },
  { time: 'Done', title: 'Job booked', text: 'And no admin on your phone at 9pm.', icon: 'check' },
];
const paths: Record<string, string> = {
  inbox: '<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.5 5.1 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.9A2 2 0 0 0 16.8 4H7.2a2 2 0 0 0-1.7 1.1z"/>',
  reply: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  bell: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/>',
  repeat: '<path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
};
---

<div class="flow-wrap">
  <div class="flow-card" data-flow>
    <div class="head">
      <p class="label">While you're on the tools</p>
      <div class="head-right">
        <span class="tag">Example</span>
        <button class="flow-toggle" type="button" aria-pressed="false">
          <span class="sr-only">Pause animation</span>
          <svg class="i-pause" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="5" y="4" width="5" height="16" rx="1"></rect><rect x="14" y="4" width="5" height="16" rx="1"></rect></svg>
          <svg class="i-play" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>
        </button>
      </div>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class:list={['step', { final: i === steps.length - 1, active: i === 0 }]}>
          <span class="icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={paths[s.icon]} />
          </span>
          <div class="body">
            <p class="time">{s.time}</p>
            <p class="title">{s.title}</p>
            <p class="text">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="payoff">Fewer missed enquiries. Less admin. Clearer days.</p>
  </div>
</div>

<script>
  // Steps light up in turn. It keeps moving, so it has a pause button
  // (WCAG 2.2.2), and it also stops while off-screen or in a background tab.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-flow]').forEach((card) => {
    const toggle = card.querySelector<HTMLButtonElement>('.flow-toggle');
    const steps = Array.from(card.querySelectorAll<HTMLElement>('.step'));
    if (reduce || steps.length === 0) {
      steps.forEach((s) => s.classList.add('seen'));
      toggle?.remove();
      return;
    }
    let i = 0;
    let timer: number | undefined;
    let userPaused = false;
    let onScreen = true;
    const show = () => {
      steps.forEach((s, n) => {
        s.classList.toggle('active', n === i);
        s.classList.toggle('seen', n < i);
      });
    };
    const tick = () => {
      show();
      i = (i + 1) % (steps.length + 1);
      // Pause briefly on the finished state before starting again
      timer = window.setTimeout(tick, i === 0 ? 2600 : 1700);
    };
    const update = () => {
      const run = !userPaused && onScreen && !document.hidden;
      window.clearTimeout(timer);
      timer = undefined;
      if (run) tick();
    };
    toggle?.addEventListener('click', () => {
      userPaused = !userPaused;
      toggle.setAttribute('aria-pressed', String(userPaused));
      const label = toggle.querySelector('.sr-only');
      if (label) label.textContent = userPaused ? 'Play animation' : 'Pause animation';
      if (userPaused) {
        // Show the whole example while paused, so nothing is half-hidden
        i = steps.length;
        steps.forEach((s) => { s.classList.remove('active'); s.classList.add('seen'); });
      }
      update();
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; update(); }).observe(card);
    }
    document.addEventListener('visibilitychange', update);
    update();
  });
</script>

<style>

  .flow-card {
    position: relative;
    background: linear-gradient(180deg, var(--ink-800), #221c2e);
    border: 1px solid var(--ink-700);
    border-radius: 18px;
    padding: clamp(20px, 3vw, 28px);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .7), 0 0 0 1px rgba(245, 165, 36, .06);
  }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
  .label { font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--amber); }
  .head-right { display: flex; align-items: center; gap: 8px; }
  .flow-toggle {
    width: 28px; height: 28px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent; color: var(--on-dark); border: 1.5px solid var(--on-dark-2);
    cursor: pointer; transition: color .2s ease, border-color .2s ease;
  }
  .flow-toggle:hover { color: var(--amber); border-color: var(--amber); }
  .flow-toggle:focus-visible { outline: 3px solid var(--amber); outline-offset: 2px; }
  .i-play { display: none; }
  .flow-toggle[aria-pressed='true'] .i-play { display: block; }
  .flow-toggle[aria-pressed='true'] .i-pause { display: none; }
  .tag { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--on-dark-2); border: 1px solid var(--ink-700); border-radius: 999px; padding: 3px 9px; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; position: relative; }
  .step {
    position: relative;
    display: flex; gap: 14px; align-items: flex-start;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid transparent;
    opacity: .5;
    transition: opacity .45s ease, background-color .45s ease, border-color .45s ease, transform .45s ease;
  }
  .step.seen { opacity: .85; }
  .step.active { opacity: 1; background: rgba(245, 165, 36, .1); border-color: rgba(245, 165, 36, .45); transform: translateX(4px); }
  .icon {
    flex: 0 0 36px; height: 36px; border-radius: 10px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--ink-700); color: var(--lav);
    transition: background-color .45s ease, color .45s ease;
  }
  .step.active .icon, .step.seen .icon { background: var(--amber); color: var(--ink-900); }
  .step.final.active .icon { box-shadow: 0 0 0 6px rgba(245, 165, 36, .2); }
  .payoff { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--ink-700); font-weight: 800; color: var(--white); font-size: 15px; }
  .time { font-size: 12px; font-weight: 700; color: var(--on-dark-2); letter-spacing: .04em; }
  .title { font-weight: 800; font-size: 16px; color: var(--white); line-height: 1.3; }
  .text { font-size: 14px; color: #c9c3dc; line-height: 1.5; }

  @media (prefers-reduced-motion: reduce) {
    .step { opacity: 1; transform: none !important; }
  }
</style>
