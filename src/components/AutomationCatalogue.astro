---
type Automation = {
  number: number;
  name: string;
  does: string;
  helps: string;
};

type Category = {
  title: string;
  items: Automation[];
};

const categories: Category[] = [
  {
    title: 'Lead capture automations',
    items: [
      { number: 1, name: 'Website enquiry to job system', does: 'Turns a website form submission into a validated record in your CRM or job platform, with files attached and staff notified.', helps: 'Stops leads getting lost between inbox and job system.' },
      { number: 2, name: 'Instant enquiry acknowledgement', does: 'Sends an immediate branded email or SMS confirming receipt and next steps.', helps: 'Gives customers certainty the moment they enquire.' },
      { number: 3, name: 'Internal lead alert', does: 'Notifies the right staff member the moment a qualified lead comes in, with escalation if nobody responds in time.', helps: 'Keeps high-value and urgent enquiries visible.' },
      { number: 4, name: 'Lead assignment and task creation', does: 'Assigns an owner, creates a follow-up task and sets a due date automatically.', helps: 'Every lead gets a named next action.' },
      { number: 5, name: 'Missed-call text response', does: 'Sends a text when a call is missed, linking back to the quote form.', helps: 'Gives callers another way to get their job details to you.' },
      { number: 6, name: 'Lead source attribution', does: 'Records which campaign, page or channel generated each enquiry.', helps: 'Shows which marketing is actually producing booked work.' },
      { number: 7, name: 'Service-area and job-fit triage', does: 'Automatically flags whether a job is in scope, needs manual review, or is unsupported.', helps: 'Saves staff time sorting unsuitable requests.' },
      { number: 8, name: 'Dormant lead reminder', does: 'Reminds staff, or the customer, when a lead has had no activity for a set period.', helps: 'Stops good opportunities disappearing through admin delay.' }
    ]
  },
  {
    title: 'Quote and sales automations',
    items: [
      { number: 9, name: 'Quote information pack', does: 'Compiles form answers, photos and notes into one organised summary for the estimator.', helps: 'Estimators start with everything in one place.' },
      { number: 10, name: 'Quote sent confirmation', does: 'Sends a message confirming the quote is ready, how to review it, and how long it is valid.', helps: 'Customers know exactly what to do next.' },
      { number: 11, name: 'Quote follow-up sequence', does: 'Sends timed reminders on open quotes and creates a call task for high-value ones, stopping automatically on response.', helps: 'Keeps quotes from going cold without manual chasing.' },
      { number: 12, name: 'Quote accepted to job creation', does: 'Converts an accepted quote straight into a job, notifies the office and creates scheduling tasks.', helps: 'The sale moves straight into delivery.' },
      { number: 13, name: 'Quote declined or expired workflow', does: 'Updates the pipeline and stops follow-ups automatically once a quote is declined or expires.', helps: 'Keeps your sales pipeline accurate.' },
      { number: 14, name: 'High-value quote alert', does: 'Flags quotes above an agreed value to the owner or sales lead.', helps: 'Makes sure your biggest opportunities get personal attention.' }
    ]
  },
  {
    title: 'Booking and scheduling automations',
    items: [
      { number: 15, name: 'Booking confirmation', does: 'Sends appointment details, arrival window and prep instructions the moment a booking is made.', helps: 'Reduces confusion right after booking.' },
      { number: 16, name: 'Appointment reminder', does: 'Sends a reminder ahead of the appointment with arrival window and change instructions.', helps: 'Cuts down forgotten appointments and confirmation calls.' },
      { number: 17, name: 'Reschedule and cancellation workflow', does: 'Notifies scheduling staff and confirms once a change request is actioned.', helps: 'Change requests reach the right person faster.' },
      { number: 18, name: 'On-the-way notification', does: 'Sends an ETA message when a technician marks the job as travelling.', helps: 'Customers know when to expect you.' },
      { number: 19, name: 'Schedule change team alert', does: 'Notifies affected staff when a job time, technician or priority changes.', helps: 'Creates fewer missed changes between office and field.' },
      { number: 20, name: 'New booking preparation task', does: 'Creates internal tasks for permits, parts or access instructions once a booking is confirmed.', helps: 'Makes pre-job prep repeatable instead of ad hoc.' }
    ]
  },
  {
    title: 'Job-delivery automations',
    items: [
      { number: 21, name: 'Job status customer updates', does: 'Sends a customer-safe update automatically when a job status changes, such as scheduled, delayed or completed.', helps: 'Cuts down “what’s happening?” calls.' },
      { number: 22, name: 'Staff job brief', does: 'Sends field staff a structured brief with location, scope, hazards and access notes before the job.', helps: 'Gives the field consistent context every time.' },
      { number: 23, name: 'Pre-start checklist workflow', does: 'Presents the right checklist and requires evidence or photos before work starts.', helps: 'Builds repeatable checks and a record trail.' },
      { number: 24, name: 'Job completion handoff', does: 'Checks for required notes, photos and sign-off before flagging the job ready for invoicing.', helps: 'Creates less delay and fewer missing details reaching billing.' },
      { number: 25, name: 'Job photo and document filing', does: 'Automatically renames, categorises and files job photos and documents.', helps: 'Makes records easy to find later.' },
      { number: 26, name: 'Recurring-service reminder', does: 'Reminds the customer, with consent, when a completed job reaches its next service date.', helps: 'Keeps maintenance work coming back consistently.' },
      { number: 27, name: 'Internal exception escalation', does: 'Alerts the responsible person when a job stalls or is missing required data, escalating if unresolved.', helps: 'Problems become visible before they turn into complaints.' }
    ]
  },
  {
    title: 'Invoice and payment automations',
    items: [
      { number: 28, name: 'Completion-to-invoice task', does: 'Creates an invoicing task or draft the moment a job passes completion checks.', helps: 'Gets completed work to invoicing faster.' },
      { number: 29, name: 'Deposit request workflow', does: 'Sends the deposit request and payment link automatically once a quote is accepted.', helps: 'Deposits get requested consistently, every time.' },
      { number: 30, name: 'Invoice delivery confirmation', does: 'Confirms an invoice was sent and alerts staff if delivery fails.', helps: 'Failed deliveries get caught quickly.' },
      { number: 31, name: 'Overdue invoice reminders', does: 'Sends escalating, professional payment reminders and creates a staff task at the final stage.', helps: 'Creates consistent debtor follow-up without awkward manual chasing.' },
      { number: 32, name: 'Payment received workflow', does: 'Sends a receipt or thank-you and notifies staff once payment clears.', helps: 'Provides prompt confirmation for both sides.' },
      { number: 33, name: 'Accounting and job-system synchronisation', does: 'Keeps approved fields in sync between your job platform and accounting software.', helps: 'Cuts double entry and keeps records clean.' },
      { number: 34, name: 'Failed payment or sync alert', does: 'Notifies staff immediately if a payment fails or an integration errors out.', helps: 'Gives financial exceptions timely human attention.' }
    ]
  },
  {
    title: 'Review and referral automations',
    items: [
      { number: 35, name: 'Post-job thank-you', does: 'Sends a personalised thank-you and care instructions once a job is complete.', helps: 'Creates a consistent, professional close to every job.' },
      { number: 36, name: 'Genuine review request', does: 'Invites the customer to leave an honest review on your chosen platform, timed after job completion.', helps: 'Builds a steady stream of real customer feedback.' },
      { number: 37, name: 'Customer issue follow-up', does: 'Creates a priority task the moment a customer reports dissatisfaction.', helps: 'Complaints get a fast human response, not silence.' },
      { number: 38, name: 'Testimonial permission workflow', does: 'Asks for and records explicit permission before publishing a customer’s feedback or name.', helps: 'Gives your testimonials traceable, genuine consent.' },
      { number: 39, name: 'Referral request', does: 'Invites happy customers to refer someone via a simple trackable link.', helps: 'Turns satisfied clients into a consistent referral channel.' }
    ]
  },
  {
    title: 'Customer-retention automations',
    items: [
      { number: 40, name: 'Maintenance due reminder', does: 'Sends a reminder when a service, inspection or replacement interval approaches.', helps: 'Repeat work does not rely on staff memory.' },
      { number: 41, name: 'Lapsed customer reactivation', does: 'Sends a limited reactivation message or creates a call list for customers who have gone quiet.', helps: 'Turns past-customer outreach into something controlled and measurable.' },
      { number: 42, name: 'Newsletter consent and audience sync', does: 'Records consent and adds the person to the right marketing list, with proper opt-in handling.', helps: 'Keeps your marketing list clean and compliant.' },
      { number: 43, name: 'Warranty or workmanship check-in', does: 'Sends a check-in after an agreed period and routes any reported issue to the right person.', helps: 'Catches potential issues before they escalate.' }
    ]
  },
  {
    title: 'Internal operations automations',
    items: [
      { number: 44, name: 'Daily operations digest', does: 'Compiles new leads, jobs, overdue tasks and outstanding invoices into one daily summary.', helps: 'Gives one clear view of the business without checking five systems.' },
      { number: 45, name: 'Weekly management dashboard', does: 'Presents agreed performance measures, including leads, pipeline, bookings and overdue invoices, on a weekly cadence.', helps: 'Supports decisions from one consistent picture every week.' },
      { number: 46, name: 'Document generation', does: 'Auto-populates approved templates, such as quotes and reports, using trusted job data.', helps: 'Gets repetitive documents done faster and more consistently.' },
      { number: 47, name: 'Email and attachment filing', does: 'Automatically files incoming emails and attachments against the right customer or job.', helps: 'Makes important correspondence easy to find later.' },
      { number: 48, name: 'Stock or consumable threshold alert', does: 'Alerts the purchasing owner when inventory drops below an agreed level.', helps: 'Makes common materials less likely to run out unnoticed.' },
      { number: 49, name: 'Licence, insurance and certificate reminder', does: 'Notifies the responsible person as an expiry date approaches, escalating if unrenewed.', helps: 'Catches admin expiries early, not after they lapse.' },
      { number: 50, name: 'Staff onboarding workflow', does: 'Creates a checklist, account requests and training tasks when a new starter is approved.', helps: 'Provides a consistent setup for every new hire.' },
      { number: 51, name: 'Staff offboarding workflow', does: 'Creates access-removal and handover tasks when a staff member leaves.', helps: 'Cuts the risk of forgotten access after departure.' },
      { number: 52, name: 'Automation health and failure alerts', does: 'Logs and flags any workflow that errors, stalls or loses authentication.', helps: 'Makes automations fail visibly instead of silently.' }
    ]
  },
  {
    title: 'AI-assisted automations',
    items: [
      { number: 53, name: 'Enquiry summarisation', does: 'Uses AI to summarise long form submissions or call transcripts and flag missing information.', helps: 'Lets staff review lengthy enquiries faster.' },
      { number: 54, name: 'Draft customer response', does: 'Prepares a draft reply for a new enquiry using your approved tone and business information, for human approval before sending.', helps: 'Speeds up drafting without handing over final judgement.' },
      { number: 55, name: 'Call transcription and action extraction', does: 'Transcribes and summarises calls, with proper consent, creating proposed tasks or notes.', helps: 'Makes fewer important details get lost after a phone call.' },
      { number: 56, name: 'Knowledge-assisted staff search', does: 'Lets staff ask questions and get cited answers from your approved internal documents.', helps: 'Helps staff find approved operational knowledge faster.' },
      { number: 57, name: 'Website FAQ and lead assistant', does: 'Provides a bounded website chat assistant that answers from approved content and hands off uncertain requests to a human.', helps: 'Gives visitors instant basic help without pretending to be a real tradesperson.' }
    ]
  }
];
---

<section class="automation-catalogue" id="automations" aria-labelledby="automations-title">
  <div class="section-inner">
    <div class="section-heading">
      <p class="kicker">Pilot automations</p>
      <h2 id="automations-title">Fix the bottleneck, not just the symptom.</h2>
      <p>Automations are selected individually to fix your specific bottlenecks — not bundled into rigid packages. Each one starts from $500 <span class="price-note">(indicative pricing, confirmed at scoping)</span>.</p>
    </div>

    <div class="catalogue-list">
      {categories.map((category) => (
        <details class="catalogue-group">
          <summary>
            <span>{category.title}</span>
            <span class="item-count">({category.items.length})</span>
          </summary>
          <div class="automation-items">
            {category.items.map((item) => (
              <article class="automation-item">
                <span class="item-number" aria-hidden="true">{String(item.number).padStart(2, '0')}</span>
                <div>
                  <h3>{item.name}</h3>
                  <p><strong>What it does:</strong> {item.does}</p>
                  <p><strong>How it helps:</strong> {item.helps}</p>
                </div>
              </article>
            ))}
          </div>
        </details>
      ))}
    </div>

    <div class="catalogue-cta">
      <div>
        <p class="kicker">Start with the biggest leak</p>
        <h2>Tell us where work gets stuck.</h2>
        <p>We will help you identify the process worth fixing first, then scope a practical system around the tools you already use.</p>
      </div>
      <a class="button button-primary" href="/contact">Talk about your systems</a>
    </div>
  </div>
</section>

<style>
  .automation-catalogue { background: #fff; color: #181532; font-family: Montserrat, Arial, sans-serif; padding: 6rem 1.5rem; }
  .section-inner { margin: 0 auto; max-width: 1040px; }
  .section-heading { max-width: 770px; margin-bottom: 2.75rem; }
  .kicker { color: #181582; font-size: .74rem; font-weight: 800; letter-spacing: .12em; line-height: 1.35; margin: 0; text-transform: uppercase; }
  h2 { font-size: clamp(2rem, 4vw, 3.4rem); letter-spacing: -.045em; line-height: 1.06; margin: .55rem 0 1rem; }
  .section-heading > p:last-child { color: #4a455c; font-size: 1.02rem; line-height: 1.75; margin: 0; }
  .price-note { color: #777289; font-size: .78rem; }
  .catalogue-list { display: grid; gap: .8rem; }
  .catalogue-group { background: #f8f8fb; border: 1px solid #e1e1ed; border-radius: .6rem; overflow: hidden; }
  .catalogue-group summary { align-items: center; color: #181532; cursor: pointer; display: flex; font-size: 1rem; font-weight: 800; justify-content: flex-start; letter-spacing: -.01em; list-style: none; padding: 1.15rem 1.25rem; }
  .catalogue-group summary::-webkit-details-marker { display: none; }
  .catalogue-group summary::after { color: #181582; content: '+'; font-size: 1.45rem; font-weight: 500; line-height: 1; margin-left: auto; }
  .catalogue-group[open] summary { background: #151029; color: #fff; }
  .catalogue-group[open] summary::after { color: #fff; content: '−'; }
  .item-count { color: #777289; font-size: .82rem; font-weight: 600; margin-left: .45rem; }
  .catalogue-group[open] .item-count { color: #d5d2e7; }
  .automation-items { background: #fff; padding: .25rem 1.25rem; }
  .automation-item { border-bottom: 1px solid #e1e1ed; display: grid; gap: 1rem; grid-template-columns: 2.5rem minmax(0, 1fr); padding: 1.25rem 0; }
  .automation-item:last-child { border-bottom: 0; }
  .item-number { color: #181582; font-size: .75rem; font-weight: 800; letter-spacing: .08em; padding-top: .18rem; }
  h3 { color: #181532; font-size: 1rem; letter-spacing: -.015em; line-height: 1.35; margin: 0 0 .55rem; }
  .automation-item p { color: #686277; font-size: .88rem; line-height: 1.6; margin: .28rem 0 0; }
  .automation-item strong { color: #4a455c; font-weight: 800; }
  .catalogue-cta { align-items: center; background: #f8f8fb; border: 1px solid #deddea; border-radius: .65rem; display: flex; gap: 2rem; justify-content: space-between; margin-top: 3rem; padding: 2rem; }
  .catalogue-cta h2 { font-size: clamp(1.55rem, 3vw, 2.35rem); margin-bottom: .7rem; }
  .catalogue-cta > div > p:last-child { color: #4a455c; font-size: .94rem; line-height: 1.65; margin: 0; max-width: 620px; }
  .button { align-items: center; border: 1px solid #4a455c; border-radius: .45rem; display: inline-flex; flex: 0 0 auto; font-size: .78rem; font-weight: 800; justify-content: center; letter-spacing: .035em; min-height: 2.85rem; padding: .75rem 1.05rem; text-decoration: none; text-transform: uppercase; transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .2s ease; }
  .button-primary { background: #4a455c; color: #fff; }
  .button-primary:hover { background: #181582; border-color: #181582; transform: translateY(-1px); }
  @media (max-width: 900px) { .automation-catalogue { padding: 4.5rem 1.25rem; } .catalogue-cta { align-items: flex-start; flex-direction: column; } }
  @media (max-width: 600px) { .catalogue-group summary { font-size: .92rem; padding: 1rem; } .automation-items { padding-inline: 1rem; } .automation-item { gap: .7rem; grid-template-columns: 2rem minmax(0, 1fr); padding: 1rem 0; } .automation-item p { font-size: .83rem; } .catalogue-cta { gap: 1.25rem; padding: 1.35rem; } .button { width: 100%; } }
  @media (max-width: 480px) { .automation-catalogue { padding-inline: 1rem; } h2 { font-size: 2rem; } .item-count { display: none; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; } }
</style>
