---
import { site } from '../data/site';
---

<div class="call-bar" role="region" aria-label="Quick contact">
  <a class="btn btn--ghost" href={site.phoneHref}>Call</a>
  <a class="btn btn--light" href="/contact">Book a call</a>
</div>

<style>
  .call-bar { display: none; }
  @media (max-width: 700px) {
    .call-bar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      position: fixed;
      left: 0; right: 0; bottom: 0;
      z-index: 40;
      padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
      background: var(--navy-800);
      border-top: 1px solid #2a2350;
    }
    .call-bar .btn { min-height: 48px; padding: 12px; }
  }
</style>
