---
import { trades } from '../data/site';
---

<section class="marquee" aria-label="Trades we work with">
  <p class="sr-only">We build for {trades.join(', ')} and more.</p>
  <div class="viewport" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => (
        <ul class="group" role="list">
          {trades.map((t) => <li>{t}<span class="dot">●</span></li>)}
          <li>And more<span class="dot">●</span></li>
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee { position: relative; background: var(--amber); color: var(--ink-900); overflow: hidden; }
  .viewport { overflow: hidden; padding-block: 16px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .track { display: flex; width: max-content; animation: scroll 55s linear infinite; }
  .group { display: flex; list-style: none; margin: 0; padding: 0; }
  .group li { display: flex; align-items: center; white-space: nowrap; font-weight: 800; font-size: 15px; letter-spacing: .12em; text-transform: uppercase; }
  .dot { font-size: 8px; margin: 0 22px; opacity: .55; }
  @keyframes scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
    .group:nth-child(2) { display: none; }
    .group { flex-wrap: wrap; justify-content: center; row-gap: 6px; }
  }
</style>
