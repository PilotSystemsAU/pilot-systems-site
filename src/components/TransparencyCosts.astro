---
const tiers = [
  {
    name: "Pilot Presence",
    price: "$1,500",
    positioning:
      "Affordable professional starting point for a sole trader or small team.",
    build: "Astro build",
    highlights: [
      "Up to 5 core pages",
      "Standard contact or quote form with spam protection",
      "Basic SEO setup: titles, meta, sitemap and Search Console",
      "Mobile-responsive build with basic accessibility foundations",
    ],
    warranty:
      "30-day defect warranty, with up to 2 consolidated revision rounds before launch.",
    featured: false,
  },
  {
    name: "Pilot Lead Engine",
    price: "$2,500",
    positioning:
      "For established businesses that want their site to actively generate, qualify and measure enquiries.",
    build: "Next.js build",
    highlights: [
      "Up to 10 pages, including service and service-area pages",
      "Advanced multi-step quote form",
      "Lightweight CMS and editor training",
      "Analytics, Search Console and conversion tracking",
    ],
    warranty:
      "30-day defect warranty, with up to 3 consolidated revision rounds and a 30-day post-launch optimisation review.",
    featured: true,
  },
  {
    name: "Pilot Digital HQ",
    price: "$5,000",
    positioning:
      "Premium, bespoke platform for growing businesses needing advanced functions and integration-ready foundations.",
    build: "Next.js + integrations",
    highlights: [
      "Up to 20 pages or templates",
      "One substantial advanced function, or two smaller functions",
      "Bespoke design system",
      "Targeted WCAG 2.2 AA review",
    ],
    warranty:
      "90-day defect warranty, with up to 4 consolidated revision rounds and 30-day and 90-day review sessions.",
    featured: false,
  },
];
---

<section class="transparency-costs" aria-labelledby="transparency-title">
  <div class="section-inner">
    <div class="section-heading">
      <div>
        <p class="kicker">CLEAR SCOPE. NO FALSE PROMISES.</p>
        <h2 id="transparency-title">TRANSPARENCY IN COSTS</h2>
      </div>

      <p class="indicative-note">
        Indicative pricing — confirm at enquiry.
      </p>
    </div>

    <div class="pricing-grid">
      {
        tiers.map((tier) => (
          <article class:list={["pricing-card", { featured: tier.featured }]}>
            {tier.featured && (
              <span class="recommended-label">POPULAR STARTING POINT</span>
            )}

            <p class="tier-name">{tier.name}</p>
            <p class="tier-price">
              <span>{tier.price}</span>
              <small>placeholder</small>
            </p>

            <p class="positioning">{tier.positioning}</p>

            <div class="tier-divider"></div>

            <p class="build-label">{tier.build}</p>

            <ul>
              {tier.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>

            <div class="warranty">
              <p class="warranty-label">WARRANTY & REVISIONS</p>
              <p>{tier.warranty}</p>
            </div>

            <a href="/contact" class="button button-secondary">
              ASK ABOUT THIS TIER
            </a>
          </article>
        ))
      }
    </div>

    <div class="payment-note">
      <span aria-hidden="true">i</span>
      <p>
        A deposit is required to begin, with milestone payments through design,
        build and launch. Third-party costs such as domain, hosting and
        subscriptions are billed separately.
      </p>
    </div>

    <div class="section-action">
      <a href="/contact" class="button button-primary">
        GET A CLEAR QUOTE
      </a>
    </div>
  </div>
</section>

<style>
  .transparency-costs {
    padding: 6rem 1.5rem;
    background: #f8f8fb;
    border-top: 1px solid #e1e1ed;
  }

  .section-inner {
    width: min(100%, 1100px);
    margin: 0 auto;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .kicker,
  .tier-name,
  .build-label,
  .warranty-label,
  .recommended-label {
    margin: 0;
    color: #777289;
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 0.5rem 0 0;
    color: #181532;
    font-size: clamp(2rem, 4vw, 3.35rem);
    letter-spacing: 0.035em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .indicative-note {
    margin: 0;
    color: #686277;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.5;
    text-align: right;
  }

  .pricing-grid {
    display: grid;
    margin-top: 2.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  .pricing-card {
    position: relative;
    display: flex;
    padding: 1.5rem;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #deddea;
    border-radius: 0.75rem;
  }

  .pricing-card.featured {
    border-color: #181582;
    box-shadow: 0 18px 38px rgba(24, 21, 130, 0.13);
  }

  .recommended-label {
    position: absolute;
    top: -0.72rem;
    left: 1.4rem;
    padding: 0.34rem 0.55rem;
    color: #ffffff;
    background: #181582;
    border-radius: 999px;
    font-size: 0.58rem;
  }

  .tier-name {
    color: #181582;
  }

  .tier-price {
    display: flex;
    margin: 0.65rem 0 0;
    align-items: baseline;
    gap: 0.5rem;
  }

  .tier-price span {
    color: #181532;
    font-size: 2.1rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .tier-price small {
    color: #777289;
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .positioning {
    min-height: 104px;
    margin: 1rem 0 0;
    color: #4a455c;
    font-size: 0.85rem;
    line-height: 1.65;
  }

  .tier-divider {
    height: 1px;
    margin: 1.25rem 0;
    background: #e1e1ed;
  }

  .build-label {
    color: #181532;
  }

  .pricing-card ul {
    display: grid;
    margin: 1rem 0 0;
    padding: 0;
    gap: 0.72rem;
    list-style: none;
  }

  .pricing-card li {
    position: relative;
    padding-left: 1.35rem;
    color: #4a455c;
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .pricing-card li::before {
    position: absolute;
    top: 0.45rem;
    left: 0;
    width: 7px;
    height: 7px;
    content: "";
    background: #181582;
    border-radius: 50%;
  }

  .warranty {
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .warranty-label {
    color: #181582;
  }

  .warranty p:last-child {
    margin: 0.45rem 0 0;
    color: #686277;
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .button {
    display: inline-flex;
    width: 100%;
    min-height: 43px;
    margin-top: 1.35rem;
    padding: 0.65rem 0.85rem;
    align-items: center;
    justify-content: center;
    border: 1px solid #4a455c;
    border-radius: 0.45rem;
    font-family: inherit;
    font-size: 0.71rem;
    font-weight: 700;
    letter-spacing: 0.035em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.18s ease-out,
      border-color 0.18s ease-out,
      color 0.18s ease-out,
      transform 0.18s ease-out;
  }

  .button-secondary {
    color: #4a455c;
    background: transparent;
  }

  .button-secondary:hover,
  .button-secondary:focus-visible {
    color: #181582;
    border-color: #181582;
    transform: translateY(-1px);
  }

  .payment-note {
    display: flex;
    margin-top: 1.5rem;
    padding: 1rem 1.1rem;
    align-items: flex-start;
    gap: 0.8rem;
    background: #eeedf7;
    border: 1px solid #deddea;
    border-radius: 0.65rem;
  }

  .payment-note span {
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    flex: 0 0 auto;
    color: #ffffff;
    background: #181582;
    border-radius: 50%;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
  }

  .payment-note p {
    margin: 0;
    color: #4a455c;
    font-size: 0.79rem;
    line-height: 1.65;
  }

  .section-action {
    display: flex;
    margin-top: 1.5rem;
  }

  .section-action .button {
    width: auto;
    margin: 0;
    border-color: transparent;
  }

  .button-primary {
    color: #ffffff;
    background: #4a455c;
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    background: #181582;
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .transparency-costs {
      padding: 4.5rem 1.25rem;
    }

    .pricing-grid {
      grid-template-columns: 1fr;
    }

    .positioning {
      min-height: auto;
    }
  }

  @media (max-width: 600px) {
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .indicative-note {
      text-align: left;
    }
  }

  @media (max-width: 480px) {
    .transparency-costs {
      padding-inline: 1rem;
    }

    .pricing-card {
      padding: 1.25rem;
    }

    .section-action,
    .section-action .button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }
</style>