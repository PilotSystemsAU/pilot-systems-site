---
import { site } from '../data/site';

interface Props {
  heading?: string;
  text?: string;
  call?: boolean;
}
const {
  heading = 'Not sure where to start?',
  text = "Book a free 15–25 minute discovery call. We’ll look at your website and how you handle enquiries, and tell you what would actually help. No obligation.",
  call = true,
} = Astro.props;
---

<section class="cta section--dark on-dark" aria-labelledby="cta-heading">
  <div class="glow" aria-hidden="true"></div>
  <div class="container inner" data-reveal>
    <h2 id="cta-heading" class="h2">{heading}</h2>
    {text && <p class="lead">{text}</p>}
    <div class="btn-row">
      <a class="btn btn--primary" href="/contact">{site.cta}</a>
      {call && <a class="btn btn--ghost" href={site.phoneHref}>Call {site.phoneDisplay}</a>}
    </div>
  </div>
</section>

<style>
  .cta { position: relative; overflow: hidden; padding-block: clamp(76px, 10vw, 112px); }
  .glow {
    position: absolute; inset: auto -10% -60% -10%; height: 120%;
    background: radial-gradient(closest-side, rgba(245, 165, 36, .16), transparent 70%);
    pointer-events: none;
  }
  .inner { position: relative; text-align: center; max-width: 900px; }
  .h2 { font-size: clamp(32px, 4.6vw, 58px); margin-bottom: 18px; }
  .lead { margin: 0 auto 34px; }
  .btn-row { justify-content: center; }
</style>
