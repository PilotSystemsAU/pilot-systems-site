---
import { site } from '../data/site';

interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Not sure where to start?',
  text = "Book a free 15–25 minute discovery call. We'll ask how your business runs, then recommend what will actually help, even if that means nothing at all.",
} = Astro.props;
---

<section class="cta section--dark on-dark" aria-labelledby="cta-heading">
  <div class="container inner">
    <h2 id="cta-heading" class="h2">{heading}</h2>
    <p class="lead">{text}</p>
    <div class="btn-row">
      <a class="btn btn--light" href="/contact">{site.cta}</a>
      <a class="btn btn--ghost" href={site.phoneHref}>Call {site.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(72px, 10vw, 100px); }
  .inner { text-align: center; max-width: 900px; }
  .h2 { font-size: clamp(32px, 4.6vw, 58px); margin-bottom: 18px; }
  .lead { margin: 0 auto 34px; }
  .btn-row { justify-content: center; }
</style>
