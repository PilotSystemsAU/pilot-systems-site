---
interface Props {
  kicker: string;
  title: string;
  intro?: string;
}
const { kicker, title, intro } = Astro.props;
---

<section class="page-hero section--dark on-dark">
  <div class="glow" aria-hidden="true"></div>
  <div class="container inner">
    <p class="kicker">{kicker}</p>
    <h1 class="h1">{title}</h1>
    {intro && <p class="lead">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero { position: relative; overflow: hidden; padding-block: clamp(64px, 9vw, 108px); }
  .glow {
    position: absolute; top: -40%; right: -15%; width: 70%; height: 160%;
    background: radial-gradient(closest-side, rgba(245, 165, 36, .14), transparent 70%);
    pointer-events: none;
  }
  .inner { position: relative; }
  .h1 { font-size: clamp(38px, 5.6vw, 72px); margin-bottom: 22px; max-width: 980px; }
  .lead { margin-bottom: 30px; }
</style>
