---
interface Props {
  kicker: string;
  title: string;
  intro?: string;
}
const { kicker, title, intro } = Astro.props;
---

<section class="page-hero section--dark on-dark">
  <div class="container">
    <p class="kicker">{kicker}</p>
    <h1 class="h1">{title}</h1>
    {intro && <p class="lead">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero { padding-block: clamp(64px, 9vw, 104px); }
  .h1 { font-size: clamp(38px, 5.6vw, 72px); margin-bottom: 22px; max-width: 960px; }
  .lead { margin-bottom: 30px; }
</style>
