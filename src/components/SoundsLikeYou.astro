---
const painPoints = [
  {
    problem: "“I miss calls when I’m on the tools.”",
    fix: "Capture every lead",
  },
  {
    problem: "“Quotes go out, then nothing happens.”",
    fix: "Follow up automatically",
  },
  {
    problem: "“My business barely shows up online.”",
    fix: "Build local visibility",
  },
  {
    problem: "“Too much gets copied between apps.”",
    fix: "Connect the admin",
  },
  {
    problem: "“I don’t know where good leads come from.”",
    fix: "Track lead sources",
  },
  {
    problem: "“My website looks old or unclear.”",
    fix: "Make trust obvious",
  },
  {
    problem: "“Everything relies on me remembering.”",
    fix: "Set practical reminders",
  },
  {
    problem: "“We should be asking for more reviews.”",
    fix: "Request genuine feedback",
  },
  {
    problem: "“Customers keep asking for updates.”",
    fix: "Keep people informed",
  },
];
---

<!-- DRAFT COPY - review before launch -->
<section class="sounds-like-you" aria-labelledby="sounds-like-you-title">
  <div class="section-inner">
    <div class="section-heading">
      <p class="kicker">DOES THIS SOUND FAMILIAR?</p>
      <h2 id="sounds-like-you-title">SOUNDS LIKE YOU</h2>
      <p>
        Your business does not need another complicated system. It needs the
        right parts working together.
      </p>
    </div>

    <div class="pain-grid">
      {
        painPoints.map((item, index) => (
          <article class="pain-card">
            <span class="pain-number">0{index + 1}</span>
            <p class="pain-problem">{item.problem}</p>
            <span class="pain-fix">{item.fix}</span>
          </article>
        ))
      }
    </div>

    <div class="section-action">
      <a href="/contact" class="button button-primary">
        TALK THROUGH YOUR SETUP
      </a>
    </div>
  </div>
</section>

<style>
  .sounds-like-you {
    padding: 6rem 1.5rem;
    background: #ffffff;
  }

  .section-inner {
    width: min(100%, 1100px);
    margin: 0 auto;
  }

  .section-heading {
    max-width: 690px;
  }

  .kicker,
  .pain-number {
    margin: 0;
    color: #777289;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 0.5rem 0 1rem;
    color: #181532;
    font-size: clamp(2rem, 4vw, 3.35rem);
    letter-spacing: 0.035em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .section-heading > p:last-child {
    margin: 0;
    color: #686277;
    font-size: 1rem;
    line-height: 1.75;
  }

  .pain-grid {
    display: grid;
    margin-top: 2.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .pain-card {
    position: relative;
    display: flex;
    min-height: 185px;
    padding: 1.35rem;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    background: #f8f8fb;
    border: 1px solid #e1e1ed;
    border-radius: 0.75rem;
    transition:
      border-color 0.18s ease-out,
      box-shadow 0.18s ease-out,
      transform 0.18s ease-out;
  }

  .pain-card::after {
    position: absolute;
    right: -2.5rem;
    bottom: -2.5rem;
    width: 7rem;
    height: 7rem;
    content: "";
    background: rgba(24, 21, 130, 0.06);
    border-radius: 50%;
    transition: transform 0.22s ease-out;
  }

  .pain-card:hover {
    border-color: #b9b7d6;
    box-shadow: 0 14px 30px rgba(24, 21, 50, 0.08);
    transform: translateY(-3px);
  }

  .pain-card:hover::after {
    transform: scale(1.18);
  }

  .pain-number {
    position: relative;
    z-index: 1;
    color: #181582;
  }

  .pain-problem {
    position: relative;
    z-index: 1;
    margin: 1.35rem 0;
    color: #181532;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.55;
  }

  .pain-fix {
    position: relative;
    z-index: 1;
    display: inline-flex;
    width: fit-content;
    padding: 0.38rem 0.6rem;
    align-items: center;
    color: #181582;
    background: #e9e8f5;
    border-radius: 999px;
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.065em;
    line-height: 1;
    text-transform: uppercase;
  }

  .section-action {
    display: flex;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 44px;
    padding: 0.65rem 1rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 0.45rem;
    font-family: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.035em;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.18s ease-out,
      border-color 0.18s ease-out,
      color 0.18s ease-out,
      transform 0.18s ease-out;
  }

  .button-primary {
    color: #ffffff;
    background: #4a455c;
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    background: #181582;
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .sounds-like-you {
      padding: 4.5rem 1.25rem;
    }

    .pain-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .pain-grid {
      grid-template-columns: 1fr;
    }

    .pain-card {
      min-height: 160px;
    }
  }

  @media (max-width: 480px) {
    .sounds-like-you {
      padding-inline: 1rem;
    }

    .section-heading h2 {
      font-size: 1.9rem;
    }

    .section-action,
    .section-action .button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pain-card,
    .pain-card::after,
    .button {
      transition: none;
    }
  }
</style>