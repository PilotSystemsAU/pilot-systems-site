---
const steps = [
  {
    number: "01",
    title: "You enquire",
    description: "Get in touch via the form or phone call.",
  },
  {
    number: "02",
    title: "Discovery call",
    description:
      "We understand your business and put together your personal design direction.",
  },
  {
    number: "03",
    title: "One week",
    description: "We build your site.",
  },
  {
    number: "04",
    title: "Live and working",
    description:
      "Your website goes live, generating leads — more time on the tools, less time on admin.",
  },
];
---

<section class="how-it-works" aria-labelledby="how-it-works-title">
  <div class="section-inner">
    <div class="section-heading">
      <p class="kicker">CLEAR FROM THE FIRST CALL</p>
      <h2 id="how-it-works-title">HOW IT WORKS</h2>
      <p>
        A practical process, clear decisions and no technical runaround.
      </p>
    </div>

    <ol class="steps-list">
      {
        steps.map((step) => (
          <li class="process-step">
            <span class="step-number">{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="section-action">
      <a href="/contact" class="button button-primary">
        START WITH A CONVERSATION
      </a>
    </div>
  </div>
</section>

<style>
  .how-it-works {
    padding: 6rem 1.5rem;
    background: #ffffff;
  }

  .section-inner {
    width: min(100%, 1100px);
    margin: 0 auto;
  }

  .section-heading {
    max-width: 680px;
  }

  .kicker,
  .step-number {
    margin: 0;
    color: #777289;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 0.5rem 0 1rem;
    color: #181532;
    font-size: clamp(2rem, 4vw, 3.35rem);
    letter-spacing: 0.035em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .section-heading > p:last-child {
    margin: 0;
    color: #686277;
    font-size: 1rem;
  }

  .steps-list {
    position: relative;
    display: grid;
    margin: 3rem 0 0;
    padding: 0;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    list-style: none;
  }

  .steps-list::before {
    position: absolute;
    top: 28px;
    right: calc(12.5% + 0.5rem);
    left: calc(12.5% + 0.5rem);
    height: 1px;
    content: "";
    background: #deddea;
  }

  .process-step {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .step-number {
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    color: #ffffff;
    background: #181582;
    border: 5px solid #ffffff;
    border-radius: 50%;
  }

  .process-step h3 {
    margin: 1rem 0 0.45rem;
    color: #181532;
    font-size: 1rem;
    letter-spacing: 0;
    line-height: 1.35;
    text-transform: none;
  }

  .process-step p {
    margin: 0;
    color: #686277;
    font-size: 0.85rem;
    line-height: 1.65;
  }

  .section-action {
    display: flex;
    margin-top: 2.75rem;
  }

  .button {
    display: inline-flex;
    min-height: 44px;
    padding: 0.65rem 1rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 0.45rem;
    font-family: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.035em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.18s ease-out,
      transform 0.18s ease-out;
  }

  .button-primary {
    color: #ffffff;
    background: #4a455c;
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    background: #181582;
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .how-it-works {
      padding: 4.5rem 1.25rem;
    }

    .steps-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }

    .steps-list::before {
      display: none;
    }

    .process-step {
      display: grid;
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 1rem;
    }

    .process-step h3 {
      margin-top: 0.1rem;
    }
  }

  @media (max-width: 600px) {
    .steps-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .how-it-works {
      padding-inline: 1rem;
    }

    .section-action,
    .section-action .button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }
</style>