---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
}
const { title, description, heading } = Astro.props;
// DRAFT flag: set to false once the solicitor has signed off the text and every
// [VERIFY] item is filled in. While true, the page is hidden from Google.
const draft = false;
// Effective date of the current legal text (Version 1.0).
const updated = '14 October 2026';
---

<BaseLayout title={title} description={description} noindex={draft}>
  <section class="legal-hero section--dark on-dark">
    <div class="container narrow">
      <p class="kicker">Legal</p>
      <h1 class="h2">{heading}</h1>
      <p class="updated">Last updated: {draft ? 'draft, not yet published' : updated}</p>
    </div>
  </section>
  <section class="section">
    <div class="container narrow">
      {draft && (
        <p class="draft" role="note"><strong>Draft:</strong> this page is being reviewed and isn't final yet.</p>
      )}
      <div class="legal">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Label each table cell with its column heading, for the stacked phone layout.
  document.querySelectorAll<HTMLTableElement>('.legal table').forEach((t) => {
    const heads = Array.from(t.querySelectorAll('thead th'), (th) => th.textContent?.trim() ?? '');
    t.querySelectorAll('tbody tr').forEach((tr) =>
      Array.from(tr.children).forEach((td, i) => heads[i] && td.setAttribute('data-label', heads[i])),
    );
    t.classList.add('stack');
  });
</script>

<style>
  .legal-hero { padding-block: clamp(56px, 7vw, 84px); }
  .narrow { max-width: 820px; }
  .h2 { font-size: clamp(34px, 5vw, 56px); }
  .updated { color: var(--on-dark-2); margin-top: 12px; }
  .draft { background: var(--amber-tint); border: 1px solid var(--amber); border-radius: 10px; padding: 14px 18px; margin-bottom: 32px; color: var(--text); }
  .legal :global(h2) { font-size: 22px; font-weight: 800; margin: 36px 0 12px; }
  .legal :global(p), .legal :global(li) { color: var(--text-2); line-height: 1.75; }
  .legal :global(p) { margin-bottom: 14px; }
  .legal :global(ul), .legal :global(ol) { padding-left: 22px; margin: 0 0 16px; display: grid; gap: 6px; }
  .legal :global(strong) { color: var(--text); }
  /* Tables never scroll sideways (no hidden scroll area for keyboard users).
     On phones each row becomes a labelled card; the script below copies the
     column headings onto the cells as labels. */
  .legal :global(table) { width: 100%; border-collapse: collapse; margin: 8px 0 20px; font-size: 15px; }
  .legal :global(th), .legal :global(td) { text-align: left; vertical-align: top; padding: 10px 14px; border: 1px solid var(--border); overflow-wrap: break-word; }
  @media (max-width: 640px) {
    .legal :global(table.stack), .legal :global(.stack tbody), .legal :global(.stack tr), .legal :global(.stack td) { display: block; width: 100%; }
    .legal :global(.stack thead) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .legal :global(.stack tr) { border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin-bottom: 12px; background: var(--white); }
    .legal :global(.stack td) { border: 0; border-top: 1px solid var(--border); padding: 10px 14px; }
    .legal :global(.stack td:first-child) { border-top: 0; background: var(--ink-900); color: var(--white); font-weight: 700; }
    .legal :global(.stack td[data-label]:not(:first-child))::before {
      content: attr(data-label); display: block; font-size: 12px; font-weight: 800;
      letter-spacing: .06em; text-transform: uppercase; color: var(--text); margin-bottom: 2px;
    }
  }
  .legal :global(th) { background: var(--ink-900); color: var(--white); font-weight: 700; }
  .legal :global(td) { background: var(--white); color: var(--text-2); }
</style>
